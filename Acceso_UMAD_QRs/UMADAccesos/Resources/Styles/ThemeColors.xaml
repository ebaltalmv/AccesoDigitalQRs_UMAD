<?xml version="1.0" encoding="utf-8" ?>
<!-- Actualizado por Antigravity -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="UMADAccesos.Resources.Styles.ThemeColors">

    <!-- Page & Surface Colors -->
    <Color x:Key="PageBackgroundLight">#F8FAFC</Color>
    <Color x:Key="PageBackgroundDark">#0F172A</Color>

    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#1E293B</Color>

    <Color x:Key="CardBackgroundLight">#FFFFFF</Color>
    <Color x:Key="CardBackgroundDark">#334155</Color>

    <!-- Text Colors -->
    <Color x:Key="TextPrimaryLight">#0F172A</Color>
    <Color x:Key="TextPrimaryDark">#F8FAFC</Color>

    <Color x:Key="TextSecondaryLight">#64748B</Color>
    <Color x:Key="TextSecondaryDark">#94A3B8</Color>

    <!-- Accent / Brand Colors (UMAD Blue: #003366) -->
    <Color x:Key="PrimaryAccent">#003366</Color>
    <Color x:Key="PrimaryAccentDark">#38BDF8</Color>
    
    <Color x:Key="PrimaryAccentHoverLight">#004A99</Color>
    <Color x:Key="PrimaryAccentHoverDark">#7DD3FC</Color>

    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="DangerColor">#EF4444</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>

    <!-- Border / Separator -->
    <Color x:Key="BorderLight">#E2E8F0</Color>
    <Color x:Key="BorderDark">#334155</Color>

    <!-- Input Fields -->
    <Color x:Key="InputBackgroundLight">#FFFFFF</Color>
    <Color x:Key="InputBackgroundDark">#0F172A</Color>

    <Color x:Key="InputErrorLight">#FEE2E2</Color>
    <Color x:Key="InputErrorDark">#450A0A</Color>

    <Color x:Key="InputWarningLight">#FEF3C7</Color>
    <Color x:Key="InputWarningDark">#451A03</Color>

    <!-- QR View specific -->
    <Color x:Key="QrBorderLight">#CBD5E1</Color>
    <Color x:Key="QrBorderDark">#475569</Color>

    <Color x:Key="StatusApprovedLight">#D1FAE5</Color>
    <Color x:Key="StatusApprovedDark">#064E3B</Color>

    <Color x:Key="StatusExpiredLight">#FEE2E2</Color>
    <Color x:Key="StatusExpiredDark">#450A0A</Color>

    <!-- Disabled -->
    <Color x:Key="DisabledLight">#94A3B8</Color>
    <Color x:Key="DisabledDark">#475569</Color>
    <Color x:Key="SecondaryAccent">#64748B</Color>

</ResourceDictionary>
