<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:UMADAccesos.ViewModels"
             x:Class="UMADAccesos.Views.SignUpView"
             x:DataType="vm:UserViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
             Title="Registro de Usuario"
             NavigationPage.HasNavigationBar="False">

    <!-- Layout de dos columnas: info a la izquierda, form a la derecha -->
    <ScrollView>
        <Grid ColumnDefinitions="{OnIdiom Desktop='*, Auto, *', Default='*'}"
              RowDefinitions="{OnIdiom Desktop='*', Default='Auto, Auto'}">
    
            <!-- Panel instrucciones (Izquierda en Desktop, Superior en Mobile) -->
            <Grid Grid.Column="0"
                  Grid.Row="0"
                  BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                  Padding="{OnIdiom Desktop=40, Default=25}">
                <VerticalStackLayout VerticalOptions="{OnIdiom Desktop=Center, Default=Start}"
                                     Spacing="20"
                                     MaximumWidthRequest="{OnIdiom Desktop=380, Default=500}">
    
                    <Label Text="Solicitud de Acceso"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource PrimaryAccent}, Dark={StaticResource PrimaryAccentDark}}" />
    
                    <BoxView HeightRequest="3"
                             WidthRequest="50"
                             Color="{AppThemeBinding Light={StaticResource PrimaryAccent}, Dark={StaticResource PrimaryAccentDark}}" />
    
                    <Label Text="¿Cómo funciona?"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                           Margin="0,10,0,0" />
    
                    <!-- Paso 1 -->
                    <Grid ColumnDefinitions="40, *" ColumnSpacing="12">
                        <Border Grid.Column="0"
                                 BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryAccent}, Dark={StaticResource PrimaryAccentDark}}"
                                 StrokeShape="RoundRectangle 20"
                                 StrokeThickness="0"
                                 WidthRequest="36"
                                 HeightRequest="36">
                            <Label Text="1"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Llena el formulario"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            <Label Text="Ingresa tus datos personales y elige tu rol."
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        </VerticalStackLayout>
                    </Grid>
    
                    <!-- Paso 2 -->
                    <Grid ColumnDefinitions="40, *" ColumnSpacing="12">
                        <Border Grid.Column="0"
                                 BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryAccent}, Dark={StaticResource PrimaryAccentDark}}"
                                 StrokeShape="RoundRectangle 20"
                                 StrokeThickness="0"
                                 WidthRequest="36"
                                 HeightRequest="36">
                            <Label Text="2"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Espera autorización"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            <Label Text="Administración revisará tu solicitud."
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        </VerticalStackLayout>
                    </Grid>
    
                    <!-- Paso 3 -->
                    <Grid ColumnDefinitions="40, *" ColumnSpacing="12">
                        <Border Grid.Column="0"
                                 BackgroundColor="{StaticResource SuccessColor}"
                                 StrokeShape="RoundRectangle 20"
                                 StrokeThickness="0"
                                 WidthRequest="36"
                                 HeightRequest="36">
                            <Label Text="3"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Usa tu QR"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            <Label Text="Recibirás tu código de acceso digital."
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        </VerticalStackLayout>
                    </Grid>
    
                    <Label Text="Alumnos y empleados deben usar correo @umad.edu.mx o @madero.edu.mx"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                           Margin="0,16,0,0" />
                </VerticalStackLayout>
            </Grid>
    
            <!-- Separador (solo Desktop) -->
            <BoxView Grid.Column="1"
                     IsVisible="{OnIdiom Desktop=True, Default=False}"
                     WidthRequest="1"
                     BackgroundColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                     VerticalOptions="Fill" />
    
            <!-- Panel formulario -->
            <VerticalStackLayout Grid.Column="{OnIdiom Desktop=2, Default=0}"
                                 Grid.Row="{OnIdiom Desktop=0, Default=1}"
                                 Spacing="12"
                                 Padding="{OnIdiom Desktop='50, 40', Default='30, 40'}"
                                 HorizontalOptions="Center"
                                 MaximumWidthRequest="{OnIdiom Desktop=420, Default=500}">
    
                <Label Text="Crear cuenta"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                <Label Text="Todos los campos marcados con * son obligatorios."
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                       Margin="0,0,0,12" />
    
                <!-- Nombre -->
                <Label Text="Nombre Completo *"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                <Border StrokeShape="RoundRectangle 10"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}"
                        Padding="15,5">
                    <Entry Placeholder="Nombre y Apellidos"
                           Text="{Binding FullName}"
                           HeightRequest="44"
                           BackgroundColor="Transparent" />
                </Border>
    
                <!-- Correo -->
                <Label Text="Correo Electrónico *"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                       Margin="0,8,0,0" />
                <Border StrokeShape="RoundRectangle 10"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}"
                        Padding="15,5">
                    <Entry Placeholder="usuario@umad.edu.mx"
                           Text="{Binding Email}"
                           Keyboard="Email"
                           HeightRequest="44"
                           BackgroundColor="Transparent" />
                </Border>
    
                <!-- Matrícula -->
                <Label Text="Matrícula / ID"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                       Margin="0,8,0,0" />
                <Border StrokeShape="RoundRectangle 10"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}"
                        Padding="15,5">
                    <Entry Placeholder="Dejar en blanco si eres visitante"
                           Text="{Binding StudentId}"
                           Keyboard="Numeric"
                           HeightRequest="44"
                           BackgroundColor="Transparent" />
                </Border>
    
                <!-- Contraseña -->
                <Label Text="Contraseña *"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                       Margin="0,8,0,0" />
                <Border StrokeShape="RoundRectangle 10"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}"
                        Padding="15,5">
                    <Entry Placeholder="Mínimo 8 caracteres"
                           Text="{Binding Password}"
                           IsPassword="True"
                           HeightRequest="44"
                           BackgroundColor="Transparent" />
                </Border>
    
                <!-- Rol -->
                <Label Text="Rol *"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                       Margin="0,8,0,0" />
                <Border StrokeShape="RoundRectangle 10"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}"
                        Padding="15,2">
                    <Picker Title="Selecciona tu Rol"
                            ItemsSource="{Binding Roles}"
                            ItemDisplayBinding="{Binding RoleName}"
                            SelectedItem="{Binding Role}"
                            HeightRequest="44"
                            BackgroundColor="Transparent" />
                </Border>
    
                <Button Text="Crear Cuenta y Solicitar Acceso"
                        Command="{Binding SaveUserCommand}"
                        BackgroundColor="{StaticResource SuccessColor}"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="52"
                        FontSize="16"
                        FontAttributes="Bold"
                        Margin="0,20,0,0" />
    
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
