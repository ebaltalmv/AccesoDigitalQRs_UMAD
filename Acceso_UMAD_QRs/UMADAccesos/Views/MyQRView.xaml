<?xml version="1.0" encoding="utf-8" ?>
<!-- Actualizado por Antigravity -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:UMADAccesos.ViewModels"
             x:Class="UMADAccesos.Views.MyQRView"
             x:DataType="vm:AccessTokenViewModel"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
             Title="Mi Acceso UMAD">

    <!-- Layout dos columnas: QR a la izquierda, info a la derecha -->
    <Grid ColumnDefinitions="{OnIdiom Desktop='*, Auto, *', Default='*'}"
          RowDefinitions="{OnIdiom Desktop='*', Default='Auto, *'}"
          Padding="{OnIdiom Desktop=0, Default=0}">

        <!-- Panel principal: QR (Izquierda en Desktop, Superior en Mobile) -->
        <Grid Grid.Column="0"
              Grid.Row="0"
              BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
              Padding="{OnIdiom Desktop=40, Default=20}">

            <!-- Estado: QR disponible -->
            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="20"
                                 MaximumWidthRequest="500">
                <VerticalStackLayout.Triggers>
                    <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding IsPending}" Value="False">
                        <Setter Property="IsVisible" Value="True" />
                    </DataTrigger>
                    <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding IsPending}" Value="True">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </VerticalStackLayout.Triggers>

                <Label Text="Tu Código de Acceso"
                       FontSize="24"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />

                <!-- QR Code con Borde Premium -->
                <Border Padding="25"
                        HorizontalOptions="Center"
                        StrokeShape="RoundRectangle 24"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                        BackgroundColor="White">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,10" Radius="20" Opacity="0.1" />
                    </Border.Shadow>
                    
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="10">
                        <zxing:BarcodeGeneratorView Format="QrCode"
                                                     Value="{Binding QrHash}"
                                                     HorizontalOptions="Center"
                                                     VerticalOptions="Center"
                                                     WidthRequest="{OnIdiom Desktop=320, Default=260}"
                                                     HeightRequest="{OnIdiom Desktop=320, Default=260}"
                                                     ForegroundColor="Black"
                                                     BackgroundColor="White">
                            <zxing:BarcodeGeneratorView.Triggers>
                                <DataTrigger TargetType="zxing:BarcodeGeneratorView"
                                             Binding="{Binding IsExpired}" Value="True">
                                    <Setter Property="Opacity" Value="0.1" />
                                </DataTrigger>
                            </zxing:BarcodeGeneratorView.Triggers>
                        </zxing:BarcodeGeneratorView>

                        <Label Text="{Binding QrHash}"
                               HorizontalOptions="Center"
                               TextColor="{StaticResource TextSecondaryLight}"
                               FontSize="11"
                               Opacity="0.7" />
                    </VerticalStackLayout>
                </Border>

                <!-- Status Badge -->
                <Border HorizontalOptions="Center"
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="0"
                        Padding="20,8">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsExpired}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource StatusExpiredLight}, Dark={StaticResource StatusExpiredDark}}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsApproved}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource StatusApprovedLight}, Dark={StaticResource StatusApprovedDark}}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label FontAttributes="Bold">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsExpired}" Value="True">
                                <Setter Property="Text" Value="⚠️  CÓDIGO EXPIRADO" />
                                <Setter Property="TextColor" Value="{StaticResource DangerColor}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsApproved}" Value="True">
                                <Setter Property="Text" Value="✅  CÓDIGO ACTIVO" />
                                <Setter Property="TextColor" Value="{StaticResource SuccessColor}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>
            </VerticalStackLayout>

            <!-- Estado: pendiente de aprobación -->
            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="20"
                                 Padding="30"
                                 IsVisible="False">
                <VerticalStackLayout.Triggers>
                    <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding IsPending}" Value="True">
                        <Setter Property="IsVisible" Value="True" />
                    </DataTrigger>
                </VerticalStackLayout.Triggers>

                <Label Text="⏳" FontSize="80" HorizontalOptions="Center" />
                <Label Text="Solicitud en Revisión"
                       FontSize="28"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                <Label Text="Estamos validando tus datos. Recibirás una notificación cuando tu acceso sea aprobado."
                       FontSize="15"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       LineHeight="1.4"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
            </VerticalStackLayout>
        </Grid>

        <!-- Separador Vertical (solo Desktop) -->
        <BoxView Grid.Column="1"
                 IsVisible="{OnIdiom Desktop=True, Default=False}"
                 WidthRequest="1"
                 BackgroundColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                 VerticalOptions="Fill" />

        <!-- Panel Detalles (Derecha en Desktop, Inferior en Mobile) -->
        <ScrollView Grid.Column="{OnIdiom Desktop=2, Default=0}"
                    Grid.Row="{OnIdiom Desktop=0, Default=1}">
            <VerticalStackLayout Spacing="20"
                                 Padding="{OnIdiom Desktop=40, Default=25}"
                                 VerticalOptions="Center"
                                 MaximumWidthRequest="{OnIdiom Desktop=480, Default=600}">

                <Label Text="Información del Token"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />

                <!-- Tarjeta Expiración -->
                <Border StrokeShape="RoundRectangle 16"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                        Padding="20">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Válido hasta:"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        <Label Text="{Binding ExpirationDate, StringFormat='{0:dd MMMM, yyyy - HH:mm} hrs'}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource PrimaryAccent}, Dark={StaticResource PrimaryAccentDark}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Botón Renovación (solo si expiró) -->
                <Button Text="Solicitar Renovación"
                        Command="{Binding RequestRenewalCommand}"
                        IsVisible="{Binding IsExpired}"
                        HeightRequest="52"
                        CornerRadius="12"
                        FontAttributes="Bold"
                        BackgroundColor="{StaticResource PrimaryAccent}"
                        TextColor="White" />

                <!-- Instrucciones -->
                <Border StrokeShape="RoundRectangle 16"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        Padding="25">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="¿Cómo ingresar?"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        
                        <Label Text="• Presenta el código QR al guardia de seguridad en el punto de acceso."
                               FontSize="13" LineHeight="1.3" />
                        <Label Text="• Asegúrate de que el brillo de tu pantalla sea suficiente para el escaneo."
                               FontSize="13" LineHeight="1.3" />
                        <Label Text="• El sistema registrará tu entrada y salida automáticamente."
                               FontSize="13" LineHeight="1.3" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
