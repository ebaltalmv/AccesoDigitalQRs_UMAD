<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:UMADAccesos.ViewModels"
             x:Class="UMADAccesos.Views.MyQRView"
             x:DataType="vm:AccessTokenViewModel"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
             Title="Mi Acceso UMAD">

    <ScrollView>
        <Grid Padding="30">
        <VerticalStackLayout Spacing="20"
                             VerticalOptions="Center"
                             IsVisible="False">
            <VerticalStackLayout.Triggers>
                <DataTrigger TargetType="VerticalStackLayout"
                             Binding="{Binding IsPending}"
                             Value="True">
                    <Setter Property="IsVisible"
                            Value="True" />
                </DataTrigger>
            </VerticalStackLayout.Triggers>

            <Image Source="waiting_icon.png"
                   HeightRequest="100"
                   HorizontalOptions="Center" />
            <Label Text="Cuenta en Revisión"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                   HorizontalOptions="Center" />
            <Label Text="Tu solicitud está siendo procesada por el administrador. Te notificaremos cuando tu QR esté listo."
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="20"
                             VerticalOptions="Center"
                             IsVisible="False">
            <VerticalStackLayout.Triggers>
                <DataTrigger TargetType="VerticalStackLayout"
                             Binding="{Binding IsPending}"
                             Value="False">
                    <Setter Property="IsVisible"
                            Value="True" />
                </DataTrigger>
            </VerticalStackLayout.Triggers>

            <Label Text="Tu Código de Acceso"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                   HorizontalOptions="Center" />

            <Border Padding="10"
                    WidthRequest="550"
                    HeightRequest="550"
                    HorizontalOptions="Center"
                    Stroke="{AppThemeBinding Light={StaticResource QrBorderLight}, Dark={StaticResource QrBorderDark}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}">
                    <VerticalStackLayout
                        WidthRequest="500"
                        HeightRequest="500">
                        <zxing:BarcodeGeneratorView Format="QrCode"
                                                    Value="{Binding QrHash}"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"
                                                    Margin="10"
                                                    ForegroundColor="Black"
                                                    BackgroundColor="White">
                            <zxing:BarcodeGeneratorView.Triggers>
                                <DataTrigger TargetType="zxing:BarcodeGeneratorView"
                                             Binding="{Binding IsExpired}"
                                             Value="True">
                                    <Setter Property="Opacity"
                                            Value="0.2" />
                                </DataTrigger>
                            </zxing:BarcodeGeneratorView.Triggers>
                        </zxing:BarcodeGeneratorView>

                        <VerticalStackLayout>
                            <Label Text="{Binding QrHash}"
                                   HorizontalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                   FontSize="10"
                                   Margin="0,5" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout HorizontalOptions="Center"
                                   Spacing="5">
                <Label Text="Expira el:"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                <Label Text="{Binding ExpirationDate, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label"
                                     Binding="{Binding IsExpired}"
                                     Value="True">
                            <Setter Property="TextColor"
                                    Value="{StaticResource DangerColor}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </HorizontalStackLayout>

            <Button Text="Solicitar Renovación"
                    Command="{Binding RequestRenewalCommand}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryAccent}, Dark={StaticResource PrimaryAccentDark}}"
                    TextColor="White"
                    IsVisible="False">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding IsExpired}"
                                 Value="True">
                        <Setter Property="IsVisible"
                                Value="True" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <Border StrokeShape="RoundRectangle 20"
                    Padding="10,5"
                    HorizontalOptions="Center">
                <Border.Triggers>
                    <DataTrigger TargetType="Border"
                                 Binding="{Binding IsExpired}"
                                 Value="True">
                        <Setter Property="BackgroundColor"
                                Value="{AppThemeBinding Light={StaticResource StatusExpiredLight}, Dark={StaticResource StatusExpiredDark}}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border"
                                 Binding="{Binding IsApproved}"
                                 Value="True">
                        <Setter Property="BackgroundColor"
                                Value="{AppThemeBinding Light={StaticResource StatusApprovedLight}, Dark={StaticResource StatusApprovedDark}}" />
                    </DataTrigger>
                </Border.Triggers>
                <Label Text="Token Activo"
                       TextColor="{StaticResource SuccessColor}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label"
                                     Binding="{Binding IsExpired}"
                                     Value="True">
                            <Setter Property="Text"
                                    Value="Token Expirado" />
                            <Setter Property="TextColor"
                                    Value="{StaticResource DangerColor}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Border>
        </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
