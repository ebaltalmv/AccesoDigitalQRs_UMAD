<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:UMADAccesos.ViewModels"
             x:Class="UMADAccesos.Views.LoginView"
             x:DataType="vm:UserViewModel"
             Title="Acceso UMAD"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
             Shell.NavBarIsVisible="False">

    <!-- Layout de dos columnas para Mac/Desktop, una sola para móvil -->
    <Grid ColumnDefinitions="{OnIdiom Desktop='*, Auto, *', Default='*'}"
          RowDefinitions="{OnIdiom Desktop='*', Default='Auto, *'}">

        <!-- Panel branding: Visible en Desktop como columna izquierda, en Mobile como header superior -->
        <Grid Grid.Column="0"
              Grid.Row="0"
              BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryAccent}, Dark=#0A1628}"
              Padding="{OnIdiom Desktop=40, Default=30}">
            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="16"
                                 MaximumWidthRequest="{OnIdiom Desktop=360, Default=500}">

                <Label Text="UMAD"
                       FontSize="{OnIdiom Desktop=48, Default=32}"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" />

                <BoxView HeightRequest="3"
                         WidthRequest="60"
                         Color="White"
                         Opacity="0.5"
                         HorizontalOptions="Center" />

                <Label Text="Sistema de Control de Acceso"
                       FontSize="{OnIdiom Desktop=18, Default=16}"
                       TextColor="White"
                       Opacity="0.9"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- Separador vertical (solo Desktop) -->
        <BoxView Grid.Column="1"
                 IsVisible="{OnIdiom Desktop=True, Default=False}"
                 WidthRequest="1"
                 BackgroundColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                 VerticalOptions="Fill" />

        <!-- Panel formulario -->
        <ScrollView Grid.Column="{OnIdiom Desktop=2, Default=0}"
                    Grid.Row="{OnIdiom Desktop=0, Default=1}">
            <VerticalStackLayout Spacing="16"
                                 Padding="{OnIdiom Desktop='50, 40', Default='30, 40'}"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 MaximumWidthRequest="{OnIdiom Desktop=400, Default=500}">

                <Label Text="Bienvenido"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />

                <Label Text="Ingresa tus credenciales para continuar"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                       Margin="0,0,0,16" />

                <Label Text="Correo institucional"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />

                <Border StrokeShape="RoundRectangle 10"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}"
                        Padding="15,5">
                    <Entry Placeholder="usuario@umad.edu.mx"
                           Text="{Binding Email}"
                           Keyboard="Email"
                           HeightRequest="44"
                           BackgroundColor="Transparent" />
                </Border>

                <Label Text="Contraseña"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                       Margin="0,8,0,0" />

                <Border StrokeShape="RoundRectangle 10"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}"
                        Padding="15,5">
                    <Entry Placeholder="••••••••"
                           Text="{Binding Password}"
                           IsPassword="True"
                           HeightRequest="44"
                           BackgroundColor="Transparent" />
                </Border>

                <Button Text="Iniciar Sesión"
                        Command="{Binding LoginCommand}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryAccent}, Dark={StaticResource PrimaryAccentDark}}"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="52"
                        FontSize="16"
                        FontAttributes="Bold"
                        Margin="0,16,0,0" />

                <BoxView HeightRequest="1"
                         BackgroundColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                         Margin="0,20" />

                <Label Text="¿Nuevo alumno o visitante?"
                       HorizontalOptions="Center"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />

                <Button Text="Solicitar Registro"
                        Command="{Binding GoToSignUpCommand}"
                        BackgroundColor="Transparent"
                        BorderColor="{AppThemeBinding Light={StaticResource PrimaryAccent}, Dark={StaticResource PrimaryAccentDark}}"
                        BorderWidth="1.5"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryAccent}, Dark={StaticResource PrimaryAccentDark}}"
                        CornerRadius="10"
                        HeightRequest="48"
                        FontAttributes="Bold" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
