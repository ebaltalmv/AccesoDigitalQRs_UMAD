<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:UMADAccesos.ViewModels"
             x:Class="UMADAccesos.Views.LoginView"
             x:DataType="vm:UserViewModel"
             Title="Acceso UMAD"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
             Shell.NavBarIsVisible="False">
    
    <Grid HorizontalOptions="Fill" VerticalOptions="Fill">
        <VerticalStackLayout Spacing="15"
                             Padding="30"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             MaximumWidthRequest="450">

            <Label Text="Sistema de Acceso UMAD"
                   FontSize="24"
                   HorizontalOptions="Center"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                   Margin="0,0,0,20" />

            <Entry Placeholder="Correo Institucional"
                   Text="{Binding Email}"
                   Keyboard="Email">
                <Entry.Triggers>
                    <DataTrigger TargetType="Entry"
                                 Binding="{Binding Email}"
                                 Value="">
                        <Setter Property="BackgroundColor"
                                Value="{AppThemeBinding Light={StaticResource InputErrorLight}, Dark={StaticResource InputErrorDark}}" />
                    </DataTrigger>
                </Entry.Triggers>
            </Entry>

            <Entry Placeholder="Contraseña"
                   Text="{Binding Password}"
                   IsPassword="True">
                <Entry.Triggers>
                    <DataTrigger TargetType="Entry"
                                 Binding="{Binding Password}"
                                 Value="">
                        <Setter Property="BackgroundColor"
                                Value="{AppThemeBinding Light={StaticResource InputErrorLight}, Dark={StaticResource InputErrorDark}}" />
                    </DataTrigger>
                </Entry.Triggers>
            </Entry>

            <Button Text="Iniciar Sesión"
                    Command="{Binding LoginCommand}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryAccent}, Dark={StaticResource PrimaryAccentDark}}"
                    TextColor="White"
                    Margin="0,10,0,0">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding Email}"
                                 Value="">
                        <Setter Property="IsEnabled"
                                Value="False" />
                        <Setter Property="BackgroundColor"
                                Value="{AppThemeBinding Light={StaticResource DisabledLight}, Dark={StaticResource DisabledDark}}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding Password}"
                                 Value="">
                        <Setter Property="IsEnabled"
                                Value="False" />
                        <Setter Property="BackgroundColor"
                                Value="{AppThemeBinding Light={StaticResource DisabledLight}, Dark={StaticResource DisabledDark}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <BoxView HeightRequest="1"
                     Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                     Margin="0,15" />

            <Label Text="¿Nuevo alumno o visitante?"
                   HorizontalOptions="Center"
                   FontSize="14"
                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />

            <Button Text="Solicitar Acceso (Registro)"
                    Command="{Binding GoToSignUpCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource PrimaryAccent}, Dark={StaticResource PrimaryAccentDark}}"
                    FontAttributes="Bold"
                    MaximumWidthRequest="300" />

        </VerticalStackLayout>
    </Grid>
</ContentPage>
