<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:UMADAccesos.ViewModels"
             x:Class="UMADAccesos.Views.AccessPointSetupView"
             x:DataType="vm:AccessLogViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
             Title="Configuración de Acceso">

    <ScrollView>
        <Grid Padding="{OnIdiom Desktop=40, Default=20}" VerticalOptions="Fill">
            <Border StrokeShape="RoundRectangle 24"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                    Padding="{OnIdiom Desktop=60, Default=30}"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    MaximumWidthRequest="{OnIdiom Desktop=600, Default=500}"
                    StrokeThickness="0">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,15" Radius="40" Opacity="0.12" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="30">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Label Text="Configuración de Turno"
                               FontSize="32"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource PrimaryAccent}, Dark={StaticResource PrimaryAccentDark}}" />
                        <BoxView HeightRequest="4" WidthRequest="60" Color="{StaticResource SuccessColor}" HorizontalOptions="Center" CornerRadius="2" />
                    </VerticalStackLayout>

                    <Label Text="Selecciona tu ubicación actual para comenzar el registro de accesos de seguridad."
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           FontSize="16"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />

                    <VerticalStackLayout Spacing="12">
                        <Label Text="Punto de Acceso"
                               FontAttributes="Bold"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        <Border StrokeShape="RoundRectangle 10"
                                Padding="15,2"
                                StrokeThickness="1"
                                Stroke="{StaticResource BorderLight}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">
                            <Picker Title="Seleccionar ubicación..."
                                    ItemsSource="{Binding AccessPoints}"
                                    SelectedItem="{Binding SelectedPoint}"
                                    HeightRequest="48" />
                        </Border>
                    </VerticalStackLayout>

                    <Button Text="Comenzar Turno"
                            Command="{Binding StartShiftCommand}"
                            HeightRequest="56"
                            FontSize="18"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            Margin="0,10,0,0">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button"
                                         Binding="{Binding SelectedPoint}"
                                         Value="{x:Null}">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    
                    <Label Text="* Podrás cambiar de ubicación en cualquier momento desde el menú principal."
                           FontSize="12"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
