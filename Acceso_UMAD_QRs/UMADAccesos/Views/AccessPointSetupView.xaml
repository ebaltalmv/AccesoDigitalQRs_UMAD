<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:UMADAccesos.ViewModels"
             x:Class="UMADAccesos.Views.AccessPointSetupView"
             x:DataType="vm:AccessLogViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
             Title="Configuración de Acceso">

    <ScrollView>
    <VerticalStackLayout Spacing="20"
                         Padding="30"
                         VerticalOptions="Center"
                         HorizontalOptions="Center"
                         MaximumWidthRequest="500">
        <Label Text="Configuración de Turno"
               FontSize="24"
               FontAttributes="Bold"
               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
               HorizontalOptions="Center" />
        <Label Text="Selecciona tu ubicación actual antes de escanear códigos."
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />

        <Picker Title="Seleccionar Punto de Acceso"
                ItemsSource="{Binding AccessPoints}"
                SelectedItem="{Binding SelectedPoint}"
                Margin="0,15,0,0" />

        <Button Text="Abrir Escáner"
                Command="{Binding StartShiftCommand}"
                BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryAccent}, Dark={StaticResource PrimaryAccentDark}}"
                TextColor="White">
            <Button.Triggers>
                <DataTrigger TargetType="Button"
                             Binding="{Binding SelectedPoint}"
                             Value="{x:Null}">
                    <Setter Property="IsEnabled"
                            Value="False" />
                    <Setter Property="BackgroundColor"
                            Value="{AppThemeBinding Light={StaticResource DisabledLight}, Dark={StaticResource DisabledDark}}" />
                </DataTrigger>
            </Button.Triggers>
        </Button>
    </VerticalStackLayout>
    </ScrollView>
</ContentPage>
