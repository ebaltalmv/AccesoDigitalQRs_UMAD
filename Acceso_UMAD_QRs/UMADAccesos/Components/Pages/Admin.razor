    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private static string ObtenerEstadoTokenVariante(TokenAcceso token)
    {
        if (token.Revocado)
        {
            return "negative";
        }

        return token.FechaExpiracion < DateTime.UtcNow ? "critical" : "positive";
    }

