    /// <summary>
    /// Inicializa fechas por defecto del formulario, suscribe cambios de sesión y carga los módulos administrativos si el rol es válido.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    protected override async Task OnInitializedAsync()
    {
        InicializarVentanaEventoPorDefecto();
        SesionActual.OnSesionCambiada += ManejarCambioSesion;

        if (EsAdministradorAutorizado())
        {
            await CargarDatosPanelAsync();
        }
    }

    /// <summary>
    /// Libera la suscripción al evento reactivo de sesión al destruir el componente.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    public void Dispose()
    {
        SesionActual.OnSesionCambiada -= ManejarCambioSesion;
    }

    /// <summary>
    /// Reacciona ante cambios de sesión recargando los datos administrativos o limpiando el estado si se revoca el rol.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private async void ManejarCambioSesion()
    {
        await InvokeAsync(async () =>
        {
            if (EsAdministradorAutorizado())
            {
                await CargarDatosPanelAsync();
            }
            else
            {
                LimpiarEstadoPrivado();
            }

            StateHasChanged();
        });
    }

    /// <summary>
    /// Verifica bajo política fail-closed que exista sesión vigente con rol AdministradorAccesos y permisos administrativos.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private bool EsAdministradorAutorizado()
    {
        SesionUsuario? sesion = SesionActual.SesionActual;
        if (!SesionActual.EstaAutenticado || sesion is null || sesion.EstaExpirada())
        {
            return false;
        }

        if (sesion.RolOperativo != RolUsuario.AdministradorAccesos)
        {
            return false;
        }

        return AutorizacionRol.TienePermiso(sesion.RolOperativo, PermisoSistema.AprobarRechazarRenovaciones)
            && AutorizacionRol.TienePermiso(sesion.RolOperativo, PermisoSistema.GestionarPasesEvento)
            && AutorizacionRol.TienePermiso(sesion.RolOperativo, PermisoSistema.RevocarTokens)
            && AutorizacionRol.TienePermiso(sesion.RolOperativo, PermisoSistema.GestionarIncidencias)
            && AutorizacionRol.TienePermiso(sesion.RolOperativo, PermisoSistema.SupervisarSincronizacionOffline);
    }

    /// <summary>
    /// Carga todas las colecciones operativas del panel administrativo desde los servicios reales sobre SQLite.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private async Task CargarDatosPanelAsync()
    {
        if (!EsAdministradorAutorizado())
        {
            return;
        }

        _cargando = true;
        _mensajeError = null;

        try
        {
            _personasActivas = await AccesoConsultaService.ObtenerPersonasActivasAsync();
            _usuarios = await GestionUsuariosService.ObtenerUsuariosAsync();
            SincronizarRolesSeleccionadosUsuarios();
            _renovacionesPendientes = await RenovacionService.ObtenerPendientesAsync();
            _pasesEvento = await AccesoConsultaService.ObtenerPasesEventoAsync();
            _tokensActivos = await AccesoConsultaService.ObtenerTokensActivosGlobalAsync();
            _incidenciasAbiertas = await IncidenciaService.ObtenerAbiertasAsync();
            _todasIncidencias = await IncidenciaService.ObtenerTodasAsync();
            _resumenCola = await SyncQueueService.ObtenerResumenColaAsync();
            _registrosPendientesSync = await SyncQueueService.ObtenerPendientesAsync(25);

            await EvaluarDictamenesIaRenovacionesAsync();
        }
        catch (Exception)
        {
            _mensajeError = "No fue posible cargar la información administrativa desde SQLite.";
        }
        finally
        {
            _cargando = false;
        }
    }

    /// <summary>
    /// Evalúa de forma no bloqueante las justificaciones de renovaciones pendientes mediante el servicio de IA activo.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private async Task EvaluarDictamenesIaRenovacionesAsync()
    {
        HashSet<int> idsVigentes = _renovacionesPendientes.Select(r => r.Id).ToHashSet();
        foreach (int idObsoleto in _dictamenesIaRenovacion.Keys.Where(k => !idsVigentes.Contains(k)).ToList())
        {
            _dictamenesIaRenovacion.Remove(idObsoleto);
        }

        foreach (SolicitudRenovacion solicitud in _renovacionesPendientes)
        {
            if (_dictamenesIaRenovacion.ContainsKey(solicitud.Id))
            {
                continue;
            }

            try
            {
                ClasificacionVisitaResult dictamen = await IaService.ClasificarMotivoVisitaAsync(solicitud.Justificacion);
                _dictamenesIaRenovacion[solicitud.Id] = dictamen;
            }
            catch (Exception)
            {
                // La evaluación IA es asistiva y nunca interrumpe la revisión administrativa.
            }
        }
    }

