    /// <summary>
    /// Filtra la lista global de tokens activos según el texto de búsqueda ingresado por el administrador.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private IReadOnlyList<TokenAcceso> ObtenerTokensFiltrados()
    {
        if (string.IsNullOrWhiteSpace(_filtroTokens))
        {
            return _tokensActivos;
        }

        string termino = _filtroTokens.Trim();
        return _tokensActivos
            .Where(t =>
                t.TipoPase.ToString().Contains(termino, StringComparison.OrdinalIgnoreCase)
                || (t.Persona?.NombreCompleto.Contains(termino, StringComparison.OrdinalIgnoreCase) ?? false)
                || (t.Persona?.Correo.Contains(termino, StringComparison.OrdinalIgnoreCase) ?? false)
                || (t.Persona?.Matricula?.Contains(termino, StringComparison.OrdinalIgnoreCase) ?? false))
            .ToList();
    }

