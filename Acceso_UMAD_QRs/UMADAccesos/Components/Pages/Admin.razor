    /// <summary>
    /// Formatea la vigencia solicitada opcional en una descripción legible para revisión administrativa.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private static string FormatearVigencia(TimeSpan? vigencia)
    {
        if (!vigencia.HasValue)
        {
            return "Vigencia estándar";
        }

        if (vigencia.Value.TotalDays >= 1)
        {
            return $"{Math.Round(vigencia.Value.TotalDays, 1)} días";
        }

        return $"{Math.Round(vigencia.Value.TotalHours, 1)} horas";
    }

    /// <summary>
    /// Resume visualmente una cadena de token firmado HMAC-SHA256 para mantener legibilidad tabular.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private static string AbreviarCodigo(string codigo)
    {
        if (string.IsNullOrWhiteSpace(codigo))
        {
            return "—";
        }

        return codigo.Length <= 24 ? codigo : $"{codigo[..12]}...{codigo[^8..]}";
    }

