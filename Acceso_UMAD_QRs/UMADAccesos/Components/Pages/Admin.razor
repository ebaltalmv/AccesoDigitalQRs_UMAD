    /// <summary>
    /// Invoca la cola de sincronización offline-first y reporta el resultado detallado en ToastNotification.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private async Task SincronizarColaAsync(bool usarSimulacionControlada)
    {
        if (!ValidarPermisoAccion(PermisoSistema.SupervisarSincronizacionOffline, out SesionUsuario? _))
        {
            return;
        }

        _procesandoAccion = true;
        _mensajeError = null;

        try
        {
            Func<RegistroAcceso, CancellationToken, Task<bool>>? despachador = usarSimulacionControlada
                ? SimularDespachoRemotoControladoAsync
                : null;

            SyncProcessResult resultado = await SyncQueueService.ProcesarColaPendienteAsync(
                despachadorRemoto: despachador,
                loteMaximo: 50);

            _ultimoResultadoSync = resultado;
            _resumenCola = await SyncQueueService.ObtenerResumenColaAsync();
            _registrosPendientesSync = await SyncQueueService.ObtenerPendientesAsync(25);

            string variante = resultado.SinRed
                ? "critical"
                : (resultado.Fallidos > 0
                    ? "negative"
                    : (resultado.Exitosos > 0 ? "positive" : "informative"));

            MostrarToast(resultado.Mensaje, variante);
        }
        catch (Exception ex)
        {
            _mensajeError = ex.Message;
            MostrarToast("Error inesperado al procesar la cola de sincronización offline.", "negative");
        }
        finally
        {
            _procesandoAccion = false;
        }
    }

    /// <summary>
    /// Despachador de simulación controlada que valida la integridad mínima del registro antes de confirmar su sincronización.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private static Task<bool> SimularDespachoRemotoControladoAsync(RegistroAcceso registro, CancellationToken ct)
    {
        ct.ThrowIfCancellationRequested();
        bool valido = registro.Id > 0
            && registro.IdentificadorGlobal != Guid.Empty
            && !string.IsNullOrWhiteSpace(registro.PuntoAcceso);
        return Task.FromResult(valido);
    }

