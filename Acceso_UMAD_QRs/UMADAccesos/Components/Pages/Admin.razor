    private static string ObtenerEstadoTokenTexto(TokenAcceso token)
    {
        if (token.Revocado)
        {
            return "Revocado";
        }

        return token.FechaExpiracion < DateTime.UtcNow ? "Expirado" : "Vigente";
    }

