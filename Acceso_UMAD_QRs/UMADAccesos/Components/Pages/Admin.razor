    /// <summary>
    /// Cierra el panel inline de restablecimiento de contraseña y purga las contraseñas temporales en memoria.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private void CerrarPanelResetContrasena()
    {
        _usuarioIdResetPassword = null;
        _resetPasswordNueva = string.Empty;
        _resetPasswordConfirmacion = string.Empty;
    }

    /// <summary>
    /// Valida y aplica el restablecimiento seguro de contraseña PBKDF2-SHA256 para el usuario seleccionado.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private async Task RestablecerContrasenaUsuarioAsync(int usuarioId)
    {
        if (!ValidarSesionAdministrativaUsuarios(out SesionUsuario? sesion))
        {
            return;
        }

        if (string.IsNullOrEmpty(_resetPasswordNueva) || _resetPasswordNueva.Length < 8)
        {
            _mensajeError = "La nueva contraseña debe contener al menos 8 caracteres.";
            MostrarToast(_mensajeError, "critical");
            return;
        }

        if (!string.Equals(_resetPasswordNueva, _resetPasswordConfirmacion, StringComparison.Ordinal))
        {
            _mensajeError = "La confirmación de la nueva contraseña no coincide.";
            MostrarToast(_mensajeError, "critical");
            return;
        }

        _procesandoAccion = true;
        _mensajeError = null;

        try
        {
            await GestionUsuariosService.RestablecerContrasenaAsync(
                usuarioId,
                _resetPasswordNueva,
                sesion!.PersonaId);

            string? nombreUsuario = _usuarios.FirstOrDefault(u => u.Id == usuarioId)?.NombreCompleto;
            CerrarPanelResetContrasena();
            await CargarDatosPanelAsync();

            MostrarToast(
                $"Contraseña restablecida correctamente para '{nombreUsuario ?? $"Usuario #{usuarioId}"}'.",
                "positive");
        }
        catch (UnauthorizedAccessException ex)
        {
            _mensajeError = ex.Message;
            MostrarToast(ex.Message, "negative");
        }
        catch (Exception ex)
        {
            _mensajeError = ex.Message;
            MostrarToast("No fue posible restablecer la contraseña del usuario.", "negative");
        }
        finally
        {
            _procesandoAccion = false;
        }
    }

