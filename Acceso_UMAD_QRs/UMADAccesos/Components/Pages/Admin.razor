    /// <summary>
    /// Filtra el directorio de usuarios por texto libre (nombre, correo o matrícula) y por rol institucional.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private IReadOnlyList<UsuarioDetalleDto> ObtenerUsuariosFiltrados()
    {
        IEnumerable<UsuarioDetalleDto> consulta = _usuarios;

        if (!string.IsNullOrWhiteSpace(_filtroRolUsuarios)
            && Enum.TryParse<RolPersona>(_filtroRolUsuarios, out RolPersona rolFiltro))
        {
            consulta = consulta.Where(u => u.Rol == rolFiltro);
        }

        if (!string.IsNullOrWhiteSpace(_filtroUsuarios))
        {
            string termino = _filtroUsuarios.Trim();
            consulta = consulta.Where(u =>
                u.NombreCompleto.Contains(termino, StringComparison.OrdinalIgnoreCase)
                || u.Correo.Contains(termino, StringComparison.OrdinalIgnoreCase)
                || (!string.IsNullOrWhiteSpace(u.Matricula)
                    && u.Matricula.Contains(termino, StringComparison.OrdinalIgnoreCase)));
        }

        return consulta.ToList();
    }

