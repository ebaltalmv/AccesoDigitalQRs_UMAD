@page "/admin"
@using System.Globalization
@implements IDisposable
@inject ISesionActualService SesionActual
@inject IAutorizacionRolService AutorizacionRol
@inject IRenovacionService RenovacionService
@inject IPaseEventoService PaseEventoService
@inject IIncidenciaService IncidenciaService
@inject IAccesoConsultaService AccesoConsultaService
@inject ITokenAccesoService TokenAccesoService
@inject ISyncQueueService SyncQueueService
@inject IIaService IaService
@inject IGestionUsuariosService GestionUsuariosService

<ToastNotification Message="@_toastMensaje" Variant="@_toastVariante" OnDismiss="CerrarToast" />

@if (!EsAdministradorAutorizado())
{
    <section class="fiori-card">
        <div class="fiori-card-header">
            <h2 class="fiori-card-title">Acceso denegado · Panel Administrativo</h2>
            <StatusBadge Text="Permiso requerido: AdministradorAccesos" Variant="negative" />
        </div>

        <div class="sap-messagestrip sap-messagestrip--error" role="alert">
            <span>
                @if (!SesionActual.EstaAutenticado || SesionActual.SesionActual is null)
                {
                    @("Debe iniciar sesión con una cuenta de Administrador de Accesos para ingresar al panel operativo ITIL.")
                }
                else
                {
                    @($"La sesión actual ({SesionActual.SesionActual.NombreCompleto}) no posee privilegios de Administrador de Accesos.")
                }
            </span>
        </div>

        <div class="fiori-actions-row">
            <a href="/" class="fiori-btn fiori-btn--standard">Volver al inicio</a>
            <a href="/login" class="fiori-btn fiori-btn--emphasized">Ir a iniciar sesión</a>
        </div>
    </section>
}
else
{
    SesionUsuario adminActual = SesionActual.SesionActual!;

    <header class="fiori-page-header">
        <div>
            <h2 class="fiori-page-title">Panel Administrativo ITIL</h2>
            <p class="fiori-page-subtitle">
                Operador: <strong>@adminActual.NombreCompleto</strong> (@adminActual.Correo) · Gestión centralizada sobre SQLite local
            </p>
        </div>
        <div class="fiori-actions-row">
            <StatusBadge Text="Administrador de Accesos" Variant="informative" />
            <button type="button"
                    class="fiori-btn fiori-btn--standard"
                    @onclick="CargarDatosPanelAsync"
                    disabled="@_cargando">
                @(_cargando ? "Actualizando..." : "Actualizar datos")
            </button>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(_mensajeError))
    {
        <div class="sap-messagestrip sap-messagestrip--error" role="alert">
            <span>@_mensajeError</span>
        </div>
    }

    <section class="fiori-grid" style="margin-bottom: 1.25rem;">
        <div class="fiori-kpi">
            <span class="fiori-kpi-label">Usuarios registrados</span>
            <span class="fiori-kpi-value">@_usuarios.Count</span>
            <span class="fiori-kpi-sub">
                Activos: @_usuarios.Count(u => u.Activo) · Admins: @_usuarios.Count(u => u.Activo && u.Rol == RolPersona.Administrador)
            </span>
        </div>
        <div class="fiori-kpi">
            <span class="fiori-kpi-label">Renovaciones pendientes</span>
            <span class="fiori-kpi-value">@_renovacionesPendientes.Count</span>
            <span class="fiori-kpi-sub">Solicitudes por dictaminar</span>
        </div>
        <div class="fiori-kpi">
            <span class="fiori-kpi-label">Tokens activos globales</span>
            <span class="fiori-kpi-value">@_tokensActivos.Count</span>
            <span class="fiori-kpi-sub">Vigentes y no revocados</span>
        </div>
        <div class="fiori-kpi">
            <span class="fiori-kpi-label">Incidencias abiertas</span>
            <span class="fiori-kpi-value">@_incidenciasAbiertas.Count</span>
            <span class="fiori-kpi-sub">Priorizadas por severidad ITIL</span>
        </div>
        <div class="fiori-kpi">
            <span class="fiori-kpi-label">Cola offline pendiente</span>
            <span class="fiori-kpi-value">@(_resumenCola?.TotalPendientesOperativos ?? 0)</span>
            <span class="fiori-kpi-sub">Accesos: @(_resumenCola?.Pendientes ?? 0) · Errores: @(_resumenCola?.ConError ?? 0)</span>
        </div>
    </section>

    <nav class="fiori-tabs" role="tablist" aria-label="Secciones administrativas">
        <button type="button"
                role="tab"
                aria-selected="@(_tabActiva == TabRenovaciones ? "true" : "false")"
                class="fiori-tab @(_tabActiva == TabRenovaciones ? "fiori-tab--active" : string.Empty)"
                @onclick="() => SeleccionarTab(TabRenovaciones)">
            Renovaciones (@_renovacionesPendientes.Count)
        </button>
        <button type="button"
                role="tab"
                aria-selected="@(_tabActiva == TabPasesEvento ? "true" : "false")"
                class="fiori-tab @(_tabActiva == TabPasesEvento ? "fiori-tab--active" : string.Empty)"
                @onclick="() => SeleccionarTab(TabPasesEvento)">
            Pases por Evento (@_pasesEvento.Count)
        </button>
        <button type="button"
                role="tab"
                aria-selected="@(_tabActiva == TabTokens ? "true" : "false")"
                class="fiori-tab @(_tabActiva == TabTokens ? "fiori-tab--active" : string.Empty)"
                @onclick="() => SeleccionarTab(TabTokens)">
            Tokens Activos (@_tokensActivos.Count)
        </button>
        <button type="button"
                role="tab"
                aria-selected="@(_tabActiva == TabIncidencias ? "true" : "false")"
                class="fiori-tab @(_tabActiva == TabIncidencias ? "fiori-tab--active" : string.Empty)"
                @onclick="() => SeleccionarTab(TabIncidencias)">
            Incidencias ITIL (@_incidenciasAbiertas.Count)
        </button>
        <button type="button"
                role="tab"
                aria-selected="@(_tabActiva == TabSync ? "true" : "false")"
                class="fiori-tab @(_tabActiva == TabSync ? "fiori-tab--active" : string.Empty)"
                @onclick="() => SeleccionarTab(TabSync)">
            Continuidad Offline (@(_resumenCola?.TotalPendientesOperativos ?? 0))
        </button>
        <button type="button"
                role="tab"
                aria-selected="@(_tabActiva == TabUsuarios ? "true" : "false")"
                class="fiori-tab @(_tabActiva == TabUsuarios ? "fiori-tab--active" : string.Empty)"
                @onclick="() => SeleccionarTab(TabUsuarios)">
            Usuarios (@_usuarios.Count)
        </button>
    </nav>

    @if (_tabActiva == TabRenovaciones)
    {
        <section class="fiori-card">
            <div class="fiori-card-header">
                <h3 class="fiori-card-title">Solicitudes de Renovación Pendientes</h3>
                <StatusBadge Text="@($"IA activa: {IaService.ModoActivo}")" Variant="informative" />
            </div>

            @if (_renovacionesPendientes.Count == 0)
            {
                <div class="fiori-empty-state">
                    No existen solicitudes de renovación pendientes en este momento.
                </div>
            }
            else
            {
                @foreach (SolicitudRenovacion solicitud in _renovacionesPendientes)
                {
                    int solicitudId = solicitud.Id;
                    _dictamenesIaRenovacion.TryGetValue(solicitudId, out ClasificacionVisitaResult? dictamenIa);

                    <article class="fiori-card">
                        <div class="fiori-card-header">
                            <div>
                                <h4 class="fiori-card-title">
                                    Solicitud #@solicitud.Id · @(solicitud.Persona?.NombreCompleto ?? $"Persona #{solicitud.PersonaId}")
                                </h4>
                                <p class="fiori-page-subtitle">
                                    @(solicitud.Persona?.Correo ?? "Sin correo")
                                    @if (!string.IsNullOrWhiteSpace(solicitud.Persona?.Matricula))
                                    {
                                        <span> · Matrícula: @solicitud.Persona.Matricula</span>
                                    }
                                    <span> · Solicitada: @FormatearHoraLocal(solicitud.FechaSolicitudUtc)</span>
                                </p>
                            </div>
                            <div class="fiori-actions-row">
                                <StatusBadge Text="@($"Pase deseado: {solicitud.TipoPaseDeseado}")" Variant="informative" />
                                <StatusBadge Text="@FormatearVigencia(solicitud.VigenciaSolicitada)" Variant="neutral" />
                                <StatusBadge Text="Pendiente" Variant="critical" />
                            </div>
                        </div>

                        <div class="fiori-form-group">
                            <span class="fiori-label">Motivo / Justificación del solicitante</span>
                            <p style="margin: 0;">@solicitud.Justificacion</p>
                        </div>

                        @if (dictamenIa is not null)
                        {
                            <div class="sap-messagestrip @(dictamenIa.RequiereAprobacionEspecial ? "sap-messagestrip--warning" : "sap-messagestrip--information")">
                                <div>
                                    <strong>Dictamen asistido por IA (@dictamenIa.ProveedorUtilizado):</strong>
                                    <span>
                                        Categoría <strong>@dictamenIa.TipoVisitaSugerido</strong> · Área sugerida: <strong>@dictamenIa.AreaDestinoSugerida</strong>
                                        · Confianza: <strong>@dictamenIa.NivelConfianza.ToString("P0", CultureInfo.InvariantCulture)</strong>
                                    </span>
                                    <div style="margin-top: 0.25rem;">@dictamenIa.Justificacion</div>
                                </div>
                                <StatusBadge Text="@(dictamenIa.RequiereAprobacionEspecial ? "Revisión reforzada" : "Flujo ordinario")"
                                             Variant="@(dictamenIa.RequiereAprobacionEspecial ? "critical" : "positive")" />
                            </div>
                        }

                        <div class="fiori-form-group">
                            <label class="fiori-label" for="@($"obs-renovacion-{solicitudId}")">
                                Observación administrativa (obligatoria para rechazar)
                            </label>
                            <textarea id="@($"obs-renovacion-{solicitudId}")"
                                      class="fiori-textarea"
                                      rows="2"
                                      maxlength="500"
                                      placeholder="Ingrese observaciones o el motivo de rechazo documentado..."
                                      value="@ObtenerTextoDiccionario(_observacionesRenovacion, solicitudId)"
                                      @oninput="(ChangeEventArgs e) => ActualizarTextoDiccionario(_observacionesRenovacion, solicitudId, e.Value?.ToString())"></textarea>
                        </div>

                        <div class="fiori-actions-row">
                            <button type="button"
                                    class="fiori-btn fiori-btn--positive"
                                    disabled="@_procesandoAccion"
                                    @onclick="() => AprobarRenovacionAsync(solicitudId)">
                                Aprobar y emitir token
                            </button>
                            <button type="button"
                                    class="fiori-btn fiori-btn--negative"
                                    disabled="@_procesandoAccion"
                                    @onclick="() => RechazarRenovacionAsync(solicitudId)">
                                Rechazar solicitud
                            </button>
                        </div>
                    </article>
                }
            }
        </section>
    }
    else if (_tabActiva == TabPasesEvento)
    {
        <section class="fiori-card">
            <div class="fiori-card-header">
                <h3 class="fiori-card-title">Emitir Nuevo Pase por Evento</h3>
                <StatusBadge Text="Emisión automática de Token QR Tipo Evento" Variant="informative" />
            </div>

            <div class="fiori-grid fiori-grid--2">
                <div class="fiori-form-group">
                    <label class="fiori-label" for="evento-persona">Persona asistente</label>
                    <select id="evento-persona" class="fiori-select" @bind="_eventoPersonaId">
                        <option value="0">-- Seleccione una persona activa --</option>
                        @foreach (PersonaResumenDto persona in _personasActivas)
                        {
                            <option value="@persona.Id">@FormatearEtiquetaPersona(persona)</option>
                        }
                    </select>
                </div>

                <div class="fiori-form-group">
                    <label class="fiori-label" for="evento-nombre">Nombre del evento</label>
                    <input id="evento-nombre"
                           type="text"
                           class="fiori-input"
                           maxlength="200"
                           placeholder="Ej. Congreso de Ingeniería UMAD 2026"
                           @bind="_eventoNombre" />
                </div>

                <div class="fiori-form-group">
                    <label class="fiori-label" for="evento-inicio">Inicio de vigencia (hora local)</label>
                    <input id="evento-inicio"
                           type="datetime-local"
                           class="fiori-input"
                           value="@_eventoInicioLocalTexto"
                           @onchange="(ChangeEventArgs e) => _eventoInicioLocalTexto = e.Value?.ToString() ?? string.Empty" />
                </div>

                <div class="fiori-form-group">
                    <label class="fiori-label" for="evento-fin">Fin de vigencia (hora local)</label>
                    <input id="evento-fin"
                           type="datetime-local"
                           class="fiori-input"
                           value="@_eventoFinLocalTexto"
                           @onchange="(ChangeEventArgs e) => _eventoFinLocalTexto = e.Value?.ToString() ?? string.Empty" />
                </div>
            </div>

            <div class="fiori-form-group">
                <label class="fiori-label" for="evento-descripcion">Descripción / detalles operativos (opcional)</label>
                <textarea id="evento-descripcion"
                          class="fiori-textarea"
                          rows="2"
                          maxlength="500"
                          placeholder="Auditorio, zona autorizada o instrucciones para caseta..."
                          @bind="_eventoDescripcion"></textarea>
            </div>

            <div class="fiori-actions-row">
                <button type="button"
                        class="fiori-btn fiori-btn--emphasized"
                        disabled="@_procesandoAccion"
                        @onclick="CrearPaseEventoAsync">
                    Emitir pase por evento
                </button>
            </div>
        </section>

        <section class="fiori-card">
            <div class="fiori-card-header">
                <h3 class="fiori-card-title">Pases por Evento Registrados</h3>
                <StatusBadge Text="@($"{_pasesEvento.Count} registros")" Variant="neutral" />
            </div>

            @if (_pasesEvento.Count == 0)
            {
                <div class="fiori-empty-state">
                    Aún no se han emitido pases por evento en SQLite.
                </div>
            }
            else
            {
                <div class="fiori-table-wrap">
                    <table class="fiori-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Evento</th>
                                <th>Asistente</th>
                                <th>Vigencia (local)</th>
                                <th>Token QR</th>
                                <th>Emitido por</th>
                                <th>Sync</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (PaseEvento pase in _pasesEvento)
                            {
                                <tr>
                                    <td>#@pase.Id</td>
                                    <td>
                                        <strong>@pase.NombreEvento</strong>
                                        @if (!string.IsNullOrWhiteSpace(pase.Descripcion))
                                        {
                                            <div class="fiori-page-subtitle">@pase.Descripcion</div>
                                        }
                                    </td>
                                    <td>
                                        @(pase.Persona?.NombreCompleto ?? $"Persona #{pase.PersonaId}")
                                        @if (!string.IsNullOrWhiteSpace(pase.Persona?.Correo))
                                        {
                                            <div class="fiori-page-subtitle">@pase.Persona.Correo</div>
                                        }
                                    </td>
                                    <td>
                                        <div>@FormatearHoraLocal(pase.FechaInicioEvento)</div>
                                        <div class="fiori-page-subtitle">hasta @FormatearHoraLocal(pase.FechaFinEvento)</div>
                                    </td>
                                    <td>
                                        @if (pase.TokenAcceso is not null)
                                        {
                                            <StatusBadge Text="@ObtenerEstadoTokenTexto(pase.TokenAcceso)"
                                                         Variant="@ObtenerEstadoTokenVariante(pase.TokenAcceso)" />
                                            <div class="fiori-mono">Token #@pase.TokenAccesoId</div>
                                        }
                                        else
                                        {
                                            <StatusBadge Text="Sin token" Variant="neutral" />
                                        }
                                    </td>
                                    <td>@(pase.CreadoPor?.NombreCompleto ?? $"Persona #{pase.CreadoPorPersonaId}")</td>
                                    <td>
                                        <StatusBadge Text="@pase.EstadoSincronizacion.ToString()"
                                                     Variant="@ObtenerVarianteSync(pase.EstadoSincronizacion)" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
    else if (_tabActiva == TabTokens)
    {
        <section class="fiori-card">
            <div class="fiori-card-header">
                <h3 class="fiori-card-title">Emitir Nuevo Token QR Firmado (HMAC-SHA256)</h3>
                <StatusBadge Text="Emisión administrativa" Variant="informative" />
            </div>

            <div class="fiori-grid fiori-grid--3">
                <div class="fiori-form-group">
                    <label class="fiori-label" for="token-persona">Titular</label>
                    <select id="token-persona" class="fiori-select" @bind="_tokenPersonaId">
                        <option value="0">-- Seleccione una persona activa --</option>
                        @foreach (PersonaResumenDto persona in _personasActivas)
                        {
                            <option value="@persona.Id">@FormatearEtiquetaPersona(persona)</option>
                        }
                    </select>
                </div>

                <div class="fiori-form-group">
                    <label class="fiori-label" for="token-tipo">Tipo de pase</label>
                    <select id="token-tipo" class="fiori-select" @bind="_tokenTipoPase">
                        @foreach (TipoPase tipo in Enum.GetValues<TipoPase>())
                        {
                            <option value="@tipo">@tipo</option>
                        }
                    </select>
                </div>

                <div class="fiori-form-group">
                    <label class="fiori-label" for="token-horas">Vigencia personalizada en horas (opcional)</label>
                    <input id="token-horas"
                           type="number"
                           min="0"
                           max="8760"
                           class="fiori-input"
                           placeholder="0 = vigencia estándar del tipo"
                           @bind="_tokenVigenciaHoras" />
                </div>
            </div>

            <div class="fiori-actions-row">
                <label class="fiori-label" style="display: inline-flex; align-items: center; gap: 0.45rem; cursor: pointer;">
                    <input type="checkbox" @bind="_tokenRevocarPrevios" />
                    Revocar tokens previos activos del titular
                </label>

                <button type="button"
                        class="fiori-btn fiori-btn--emphasized"
                        disabled="@_procesandoAccion"
                        @onclick="EmitirTokenAsync">
                    Emitir token QR
                </button>
            </div>
        </section>

        <section class="fiori-card">
            <div class="fiori-card-header">
                <h3 class="fiori-card-title">Tokens Activos Globales y Revocación</h3>
                <div class="fiori-actions-row">
                    <input type="search"
                           class="fiori-input"
                           style="max-width: 280px;"
                           placeholder="Filtrar por nombre, correo o tipo..."
                           @bind="_filtroTokens"
                           @bind:event="oninput" />
                </div>
            </div>

            @{
                IReadOnlyList<TokenAcceso> tokensFiltrados = ObtenerTokensFiltrados();
            }

            @if (tokensFiltrados.Count == 0)
            {
                <div class="fiori-empty-state">
                    No se encontraron tokens activos que coincidan con el criterio actual.
                </div>
            }
            else
            {
                <div class="fiori-table-wrap">
                    <table class="fiori-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Titular</th>
                                <th>Tipo</th>
                                <th>Vigencia (local)</th>
                                <th>Firma QR</th>
                                <th>Revocación con motivo obligatorio</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (TokenAcceso token in tokensFiltrados)
                            {
                                int tokenId = token.Id;

                                <tr>
                                    <td>#@token.Id</td>
                                    <td>
                                        <strong>@(token.Persona?.NombreCompleto ?? $"Persona #{token.PersonaId}")</strong>
                                        <div class="fiori-page-subtitle">
                                            @(token.Persona?.Correo ?? "Sin correo")
                                            @if (!string.IsNullOrWhiteSpace(token.Persona?.Matricula))
                                            {
                                                <span> · @token.Persona.Matricula</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <StatusBadge Text="@token.TipoPase.ToString()" Variant="informative" />
                                    </td>
                                    <td>
                                        <div>Emitido: @FormatearHoraLocal(token.FechaEmision)</div>
                                        <div class="fiori-page-subtitle">Expira: @FormatearHoraLocal(token.FechaExpiracion)</div>
                                    </td>
                                    <td class="fiori-mono">@AbreviarCodigo(token.CodigoFirmado)</td>
                                    <td>
                                        <div class="fiori-actions-row">
                                            <input type="text"
                                                   class="fiori-input"
                                                   style="min-width: 190px; max-width: 240px;"
                                                   maxlength="250"
                                                   placeholder="Motivo de revocación..."
                                                   value="@ObtenerTextoDiccionario(_motivosRevocacion, tokenId)"
                                                   @oninput="(ChangeEventArgs e) => ActualizarTextoDiccionario(_motivosRevocacion, tokenId, e.Value?.ToString())" />
                                            <button type="button"
                                                    class="fiori-btn fiori-btn--negative fiori-btn--compact"
                                                    disabled="@_procesandoAccion"
                                                    @onclick="() => RevocarTokenAsync(tokenId)">
                                                Revocar
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
    else if (_tabActiva == TabIncidencias)
    {
        <section class="fiori-card">
            <div class="fiori-card-header">
                <h3 class="fiori-card-title">Gestión de Incidencias ITIL 4</h3>
                <div class="fiori-actions-row">
                    <button type="button"
                            class="fiori-btn @(!_mostrarTodasIncidencias ? "fiori-btn--emphasized" : "fiori-btn--standard") fiori-btn--compact"
                            @onclick="() => CambiarFiltroIncidenciasAsync(false)">
                        Abiertas / Investigación (@_incidenciasAbiertas.Count)
                    </button>
                    <button type="button"
                            class="fiori-btn @(_mostrarTodasIncidencias ? "fiori-btn--emphasized" : "fiori-btn--standard") fiori-btn--compact"
                            @onclick="() => CambiarFiltroIncidenciasAsync(true)">
                        Historial completo (@_todasIncidencias.Count)
                    </button>
                </div>
            </div>

            @{
                IReadOnlyList<Incidencia> incidenciasVisibles = _mostrarTodasIncidencias ? _todasIncidencias : _incidenciasAbiertas;
            }

            @if (incidenciasVisibles.Count == 0)
            {
                <div class="fiori-empty-state">
                    No existen incidencias para el filtro seleccionado.
                </div>
            }
            else
            {
                @foreach (Incidencia incidencia in incidenciasVisibles)
                {
                    int incidenciaId = incidencia.Id;
                    string? rutaEvidencia = incidencia.RutaEvidenciaFoto;
                    _evidenciasDataUri.TryGetValue(incidenciaId, out string? evidenciaDataUri);

                    <article class="fiori-card">
                        <div class="fiori-card-header">
                            <div>
                                <h4 class="fiori-card-title">Incidencia #@incidencia.Id · @incidencia.Titulo</h4>
                                <p class="fiori-page-subtitle">
                                    Reportada por: @(incidencia.ReportadoPor?.NombreCompleto ?? $"Persona #{incidencia.ReportadoPorPersonaId}")
                                    · @FormatearHoraLocal(incidencia.FechaReporteUtc)
                                    @if (incidencia.RegistroAccesoId.HasValue)
                                    {
                                        <span> · Registro de acceso #@incidencia.RegistroAccesoId</span>
                                    }
                                    @if (incidencia.FechaResolucionUtc.HasValue)
                                    {
                                        <span> · Resuelta: @FormatearHoraLocal(incidencia.FechaResolucionUtc.Value)</span>
                                    }
                                </p>
                            </div>
                            <div class="fiori-actions-row">
                                <StatusBadge Text="@($"Severidad: {incidencia.Severidad}")"
                                             Variant="@ObtenerVarianteSeveridad(incidencia.Severidad)" />
                                <StatusBadge Text="@ObtenerEtiquetaEstadoIncidencia(incidencia.Estado)"
                                             Variant="@ObtenerVarianteEstadoIncidencia(incidencia.Estado)" />
                            </div>
                        </div>

                        <p style="margin-top: 0;">@incidencia.Descripcion</p>

                        @if (!string.IsNullOrWhiteSpace(incidencia.RutaEvidenciaFoto))
                        {
                            <div class="fiori-form-group">
                                <div class="fiori-actions-row">
                                    <span class="fiori-label">Evidencia fotográfica:</span>
                                    <span class="fiori-mono">@incidencia.RutaEvidenciaFoto</span>
                                    @if (evidenciaDataUri is null)
                                    {
                                        <button type="button"
                                                class="fiori-btn fiori-btn--standard fiori-btn--compact"
                                                @onclick="() => CargarEvidenciaIncidenciaAsync(incidenciaId, rutaEvidencia)">
                                            Ver evidencia
                                        </button>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(evidenciaDataUri))
                                {
                                    <img src="@evidenciaDataUri"
                                         alt="@($"Evidencia fotográfica de incidencia #{incidenciaId}")"
                                         class="fiori-evidence-preview" />
                                }
                            </div>
                        }

                        <div class="fiori-actions-row">
                            <span class="fiori-label">Actualizar estado ITIL:</span>
                            @if (incidencia.Estado != EstadoIncidencia.EnInvestigacion)
                            {
                                <button type="button"
                                        class="fiori-btn fiori-btn--standard fiori-btn--compact"
                                        disabled="@_procesandoAccion"
                                        @onclick="() => ActualizarEstadoIncidenciaAsync(incidenciaId, EstadoIncidencia.EnInvestigacion)">
                                    En investigación
                                </button>
                            }
                            @if (incidencia.Estado != EstadoIncidencia.Resuelta)
                            {
                                <button type="button"
                                        class="fiori-btn fiori-btn--positive fiori-btn--compact"
                                        disabled="@_procesandoAccion"
                                        @onclick="() => ActualizarEstadoIncidenciaAsync(incidenciaId, EstadoIncidencia.Resuelta)">
                                    Marcar resuelta
                                </button>
                            }
                            @if (incidencia.Estado != EstadoIncidencia.Cerrada)
                            {
                                <button type="button"
                                        class="fiori-btn fiori-btn--emphasized fiori-btn--compact"
                                        disabled="@_procesandoAccion"
                                        @onclick="() => ActualizarEstadoIncidenciaAsync(incidenciaId, EstadoIncidencia.Cerrada)">
                                    Cerrar incidencia
                                </button>
                            }
                            @if (incidencia.Estado is EstadoIncidencia.Resuelta or EstadoIncidencia.Cerrada)
                            {
                                <button type="button"
                                        class="fiori-btn fiori-btn--standard fiori-btn--compact"
                                        disabled="@_procesandoAccion"
                                        @onclick="() => ActualizarEstadoIncidenciaAsync(incidenciaId, EstadoIncidencia.Abierta)">
                                    Reabrir
                                </button>
                            }
                        </div>
                    </article>
                }
            }
        </section>
    }
    else if (_tabActiva == TabSync)
    {
        <section class="fiori-card">
            <div class="fiori-card-header">
                <h3 class="fiori-card-title">Continuidad Operativa Offline-First (Cola de Sincronización)</h3>
                <StatusBadge Text="@(_resumenCola?.UltimoIntentoUtc.HasValue == true ? $"Último intento: {FormatearHoraLocal(_resumenCola.UltimoIntentoUtc.Value)}" : "Sin intentos registrados")"
                             Variant="informative" />
            </div>

            <div class="fiori-grid fiori-grid--4" style="margin-bottom: 1rem;">
                <div class="fiori-kpi">
                    <span class="fiori-kpi-label">Accesos pendientes</span>
                    <span class="fiori-kpi-value">@(_resumenCola?.Pendientes ?? 0)</span>
                    <span class="fiori-kpi-sub">En espera de despacho</span>
                </div>
                <div class="fiori-kpi">
                    <span class="fiori-kpi-label">Accesos sincronizados</span>
                    <span class="fiori-kpi-value">@(_resumenCola?.Sincronizados ?? 0)</span>
                    <span class="fiori-kpi-sub">Confirmados</span>
                </div>
                <div class="fiori-kpi">
                    <span class="fiori-kpi-label">Accesos con error</span>
                    <span class="fiori-kpi-value">@(_resumenCola?.ConError ?? 0)</span>
                    <span class="fiori-kpi-sub">Disponibles para reintento</span>
                </div>
                <div class="fiori-kpi">
                    <span class="fiori-kpi-label">Otras entidades pendientes</span>
                    <span class="fiori-kpi-value">
                        @((_resumenCola?.PasesEventoPendientes ?? 0) + (_resumenCola?.RenovacionesPendientes ?? 0) + (_resumenCola?.IncidenciasPendientes ?? 0))
                    </span>
                    <span class="fiori-kpi-sub">
                        Eventos: @(_resumenCola?.PasesEventoPendientes ?? 0) · Renov.: @(_resumenCola?.RenovacionesPendientes ?? 0) · Inc.: @(_resumenCola?.IncidenciasPendientes ?? 0)
                    </span>
                </div>
            </div>

            @if (_ultimoResultadoSync is not null)
            {
                <div class="sap-messagestrip @ObtenerClaseResultadoSync(_ultimoResultadoSync)">
                    <div>
                        <strong>Última ejecución de sincronización:</strong> @_ultimoResultadoSync.Mensaje
                        <div class="fiori-page-subtitle">
                            Procesados: @_ultimoResultadoSync.Procesados · Exitosos: @_ultimoResultadoSync.Exitosos · Fallidos: @_ultimoResultadoSync.Fallidos · Sin red: @(_ultimoResultadoSync.SinRed ? "Sí" : "No")
                        </div>
                    </div>
                </div>
            }

            <div class="fiori-actions-row" style="margin-bottom: 1rem;">
                <button type="button"
                        class="fiori-btn fiori-btn--emphasized"
                        disabled="@_procesandoAccion"
                        @onclick="() => SincronizarColaAsync(usarSimulacionControlada: true)">
                    Sincronizar cola (simulación controlada)
                </button>
                <button type="button"
                        class="fiori-btn fiori-btn--standard"
                        disabled="@_procesandoAccion"
                        @onclick="() => SincronizarColaAsync(usarSimulacionControlada: false)">
                    Verificar estado sin despachador remoto
                </button>
            </div>

            <h4 class="fiori-card-title" style="margin-bottom: 0.75rem;">Lote pendiente en SQLite (@_registrosPendientesSync.Count)</h4>

            @if (_registrosPendientesSync.Count == 0)
            {
                <div class="fiori-empty-state">
                    No existen registros de acceso pendientes o con error en la cola local.
                </div>
            }
            else
            {
                <div class="fiori-table-wrap">
                    <table class="fiori-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Persona</th>
                                <th>Punto de acceso</th>
                                <th>Movimiento</th>
                                <th>Fecha (local)</th>
                                <th>Estado</th>
                                <th>Reintentos</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (RegistroAcceso registro in _registrosPendientesSync)
                            {
                                <tr>
                                    <td>#@registro.Id</td>
                                    <td>@(registro.Persona?.NombreCompleto ?? $"Persona #{registro.PersonaId}")</td>
                                    <td>@registro.PuntoAcceso</td>
                                    <td>@registro.TipoMovimiento (@registro.Resultado)</td>
                                    <td>@FormatearHoraLocal(registro.FechaHora)</td>
                                    <td>
                                        <StatusBadge Text="@registro.EstadoSincronizacion.ToString()"
                                                     Variant="@ObtenerVarianteSync(registro.EstadoSincronizacion)" />
                                    </td>
                                    <td>@registro.Reintentos</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
    else if (_tabActiva == TabUsuarios)
    {
        <section class="fiori-card">
            <div class="fiori-card-header">
                <h3 class="fiori-card-title">Alta de Nuevo Usuario</h3>
                <StatusBadge Text="Aprovisionamiento seguro PBKDF2-SHA256" Variant="informative" />
            </div>

            <div class="fiori-grid fiori-grid--3">
                <div class="fiori-form-group">
                    <label class="fiori-label" for="usuario-nombre">Nombre completo</label>
                    <input id="usuario-nombre"
                           type="text"
                           class="fiori-input"
                           maxlength="150"
                           placeholder="Ej. Ana Sofía Morales Pérez"
                           disabled="@_procesandoAccion"
                           @bind="_nuevoUsuarioNombre" />
                </div>

                <div class="fiori-form-group">
                    <label class="fiori-label" for="usuario-correo">Correo institucional</label>
                    <input id="usuario-correo"
                           type="email"
                           class="fiori-input"
                           maxlength="200"
                           placeholder="nombre.apellido@umad.edu.mx"
                           disabled="@_procesandoAccion"
                           @bind="_nuevoUsuarioCorreo" />
                </div>

                <div class="fiori-form-group">
                    <label class="fiori-label" for="usuario-matricula">Matrícula (opcional)</label>
                    <input id="usuario-matricula"
                           type="text"
                           class="fiori-input"
                           maxlength="40"
                           placeholder="Ej. A2026015 (opcional)"
                           disabled="@_procesandoAccion"
                           @bind="_nuevoUsuarioMatricula" />
                </div>

                <div class="fiori-form-group">
                    <label class="fiori-label" for="usuario-rol">Rol institucional</label>
                    <select id="usuario-rol"
                            class="fiori-select"
                            disabled="@_procesandoAccion"
                            @bind="_nuevoUsuarioRol">
                        @foreach (RolPersona rol in Enum.GetValues<RolPersona>())
                        {
                            <option value="@rol">@ObtenerEtiquetaRolPersona(rol)</option>
                        }
                    </select>
                </div>

                <div class="fiori-form-group">
                    <label class="fiori-label" for="usuario-password">Contraseña (mín. 8 caracteres)</label>
                    <input id="usuario-password"
                           type="password"
                           class="fiori-input"
                           autocomplete="new-password"
                           placeholder="Mínimo 8 caracteres"
                           disabled="@_procesandoAccion"
                           @bind="_nuevoUsuarioPassword" />
                </div>

                <div class="fiori-form-group">
                    <label class="fiori-label" for="usuario-password-confirmar">Confirmar contraseña</label>
                    <input id="usuario-password-confirmar"
                           type="password"
                           class="fiori-input"
                           autocomplete="new-password"
                           placeholder="Repite la contraseña"
                           disabled="@_procesandoAccion"
                           @bind="_nuevoUsuarioConfirmarPassword" />
                </div>
            </div>

            <div class="fiori-grid fiori-grid--2" style="align-items: end;">
                <div class="fiori-form-group">
                    <label class="fiori-label" style="display: inline-flex; align-items: center; gap: 0.45rem; cursor: pointer;">
                        <input type="checkbox"
                               disabled="@_procesandoAccion"
                               @bind="_nuevoUsuarioEmitirTokenInicial" />
                        Emitir pase QR inicial al crear la cuenta
                    </label>
                    <span class="fiori-field-hint">
                        Si se activa, el usuario recibirá de inmediato un token QR firmado HMAC-SHA256 listo para acceso.
                    </span>
                </div>

                <div class="fiori-form-group">
                    <label class="fiori-label" for="usuario-tipo-pase">Tipo de pase inicial</label>
                    <select id="usuario-tipo-pase"
                            class="fiori-select"
                            disabled="@(_procesandoAccion || !_nuevoUsuarioEmitirTokenInicial)"
                            @bind="_nuevoUsuarioTipoPaseInicial">
                        @foreach (TipoPase tipo in Enum.GetValues<TipoPase>())
                        {
                            <option value="@tipo">@tipo</option>
                        }
                    </select>
                </div>
            </div>

            <div class="fiori-actions-row">
                <button type="button"
                        class="fiori-btn fiori-btn--emphasized"
                        disabled="@_procesandoAccion"
                        @onclick="CrearUsuarioAsync">
                    Crear usuario
                </button>
            </div>
        </section>

        <section class="fiori-card">
            @{
                IReadOnlyList<UsuarioDetalleDto> usuariosFiltrados = ObtenerUsuariosFiltrados();
            }

            <div class="fiori-card-header">
                <h3 class="fiori-card-title">Directorio y Gestión de Usuarios</h3>
                <StatusBadge Text="@($"{usuariosFiltrados.Count} de {_usuarios.Count} usuarios")" Variant="neutral" />
            </div>

            <div class="fiori-filter-bar">
                <div class="fiori-field">
                    <label class="fiori-label" for="filtro-usuarios-texto">Buscar usuario</label>
                    <input id="filtro-usuarios-texto"
                           type="search"
                           class="fiori-input"
                           placeholder="Nombre, correo o matrícula..."
                           @bind="_filtroUsuarios"
                           @bind:event="oninput" />
                </div>

                <div class="fiori-field">
                    <label class="fiori-label" for="filtro-usuarios-rol">Filtrar por rol</label>
                    <select id="filtro-usuarios-rol"
                            class="fiori-select"
                            @bind="_filtroRolUsuarios">
                        <option value="">Todos los roles</option>
                        @foreach (RolPersona rol in Enum.GetValues<RolPersona>())
                        {
                            <option value="@rol.ToString()">@ObtenerEtiquetaRolPersona(rol)</option>
                        }
                    </select>
                </div>

                @if (!string.IsNullOrWhiteSpace(_filtroUsuarios) || !string.IsNullOrWhiteSpace(_filtroRolUsuarios))
                {
                    <div class="fiori-field">
                        <button type="button"
                                class="fiori-btn fiori-btn--standard fiori-btn--compact"
                                @onclick="LimpiarFiltrosUsuarios">
                            Limpiar filtros
                        </button>
                    </div>
                }
            </div>

            @if (usuariosFiltrados.Count == 0)
            {
                <div class="fiori-empty-state">
                    No se encontraron usuarios que coincidan con los criterios de búsqueda actuales.
                </div>
            }
            else
            {
                <div class="fiori-table-wrap">
                    <table class="fiori-table">
                        <thead>
                            <tr>
                                <th>Usuario</th>
                                <th>Matrícula</th>
                                <th>Rol institucional</th>
                                <th>Estado</th>
                                <th>Tokens activos</th>
                                <th>Fecha de alta</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (UsuarioDetalleDto usuario in usuariosFiltrados)
                            {
                                int usuarioId = usuario.Id;
                                bool esCuentaPropia = usuarioId == adminActual.PersonaId;
                                RolPersona rolSeleccionado = ObtenerRolSeleccionadoUsuario(usuario);
                                bool rolModificado = rolSeleccionado != usuario.Rol;
                                bool panelResetAbierto = _usuarioIdResetPassword == usuarioId;

                                <tr @key="@($"usuario-{usuarioId}")" class="@(panelResetAbierto ? "fiori-row-selected" : string.Empty)">
                                    <td>
                                        <strong>@usuario.NombreCompleto</strong>
                                        @if (esCuentaPropia)
                                        {
                                            <StatusBadge Text="Tu cuenta" Variant="informative" />
                                        }
                                        <div class="fiori-page-subtitle">@usuario.Correo</div>
                                    </td>
                                    <td class="fiori-mono">
                                        @(string.IsNullOrWhiteSpace(usuario.Matricula) ? "—" : usuario.Matricula)
                                    </td>
                                    <td>
                                        <div class="fiori-actions-row">
                                            <select class="fiori-select"
                                                    style="min-width: 145px; max-width: 175px;"
                                                    aria-label="@($"Rol institucional de {usuario.NombreCompleto}")"
                                                    value="@rolSeleccionado.ToString()"
                                                    disabled="@_procesandoAccion"
                                                    @onchange="(ChangeEventArgs e) => ActualizarSeleccionRolUsuario(usuarioId, e.Value?.ToString())">
                                                @foreach (RolPersona rol in Enum.GetValues<RolPersona>())
                                                {
                                                    <option value="@rol.ToString()">@ObtenerEtiquetaRolPersona(rol)</option>
                                                }
                                            </select>
                                            <button type="button"
                                                    class="fiori-btn fiori-btn--standard fiori-btn--compact"
                                                    disabled="@(_procesandoAccion || !rolModificado)"
                                                    @onclick="() => ActualizarRolUsuarioAsync(usuarioId)">
                                                Guardar rol
                                            </button>
                                        </div>
                                    </td>
                                    <td>
                                        <StatusBadge Text="@(usuario.Activo ? "Activo" : "Inactivo")"
                                                     Variant="@(usuario.Activo ? "positive" : "negative")" />
                                    </td>
                                    <td>
                                        <StatusBadge Text="@($"{usuario.TokensActivosCount} activos")"
                                                     Variant="@(usuario.TokensActivosCount > 0 ? "informative" : "neutral")" />
                                    </td>
                                    <td>@FormatearHoraLocal(usuario.FechaCreacionUtc)</td>
                                    <td>
                                        <div class="fiori-actions-row">
                                            <button type="button"
                                                    class="fiori-btn @(usuario.Activo ? "fiori-btn--negative" : "fiori-btn--positive") fiori-btn--compact"
                                                    disabled="@(_procesandoAccion || esCuentaPropia)"
                                                    title="@(esCuentaPropia ? "No puedes desactivar tu propia cuenta administradora activa." : string.Empty)"
                                                    @onclick="() => ActualizarEstadoUsuarioAsync(usuarioId, !usuario.Activo)">
                                                @(usuario.Activo ? "Desactivar" : "Activar")
                                            </button>
                                            <button type="button"
                                                    class="fiori-btn fiori-btn--standard fiori-btn--compact"
                                                    disabled="@_procesandoAccion"
                                                    @onclick="() => AlternarPanelResetContrasena(usuarioId)">
                                                @(panelResetAbierto ? "Cerrar clave" : "Restablecer clave")
                                            </button>
                                        </div>
                                    </td>
                                </tr>

                                @if (panelResetAbierto)
                                {
                                    <tr @key="@($"reset-{usuarioId}")" class="fiori-row-selected">
                                        <td colspan="7">
                                            <div class="fiori-detail-panel">
                                                <div class="fiori-card-header" style="margin-bottom: 0.75rem;">
                                                    <h4 class="fiori-card-title">
                                                        Restablecer contraseña · @usuario.NombreCompleto (@usuario.Correo)
                                                    </h4>
                                                    <StatusBadge Text="Hash PBKDF2-SHA256" Variant="critical" />
                                                </div>

                                                <div class="fiori-grid fiori-grid--2">
                                                    <div class="fiori-form-group">
                                                        <label class="fiori-label" for="@($"reset-pass-{usuarioId}")">
                                                            Nueva contraseña (mín. 8 caracteres)
                                                        </label>
                                                        <input id="@($"reset-pass-{usuarioId}")"
                                                               type="password"
                                                               class="fiori-input"
                                                               autocomplete="new-password"
                                                               placeholder="Ingresa la nueva contraseña"
                                                               disabled="@_procesandoAccion"
                                                               @bind="_resetPasswordNueva" />
                                                    </div>

                                                    <div class="fiori-form-group">
                                                        <label class="fiori-label" for="@($"reset-pass-confirm-{usuarioId}")">
                                                            Confirmar nueva contraseña
                                                        </label>
                                                        <input id="@($"reset-pass-confirm-{usuarioId}")"
                                                               type="password"
                                                               class="fiori-input"
                                                               autocomplete="new-password"
                                                               placeholder="Repite la nueva contraseña"
                                                               disabled="@_procesandoAccion"
                                                               @bind="_resetPasswordConfirmacion" />
                                                    </div>
                                                </div>

                                                <div class="fiori-actions-row">
                                                    <button type="button"
                                                            class="fiori-btn fiori-btn--emphasized fiori-btn--compact"
                                                            disabled="@_procesandoAccion"
                                                            @onclick="() => RestablecerContrasenaUsuarioAsync(usuarioId)">
                                                        Guardar nueva contraseña
                                                    </button>
                                                    <button type="button"
                                                            class="fiori-btn fiori-btn--standard fiori-btn--compact"
                                                            disabled="@_procesandoAccion"
                                                            @onclick="CerrarPanelResetContrasena">
                                                        Cancelar
                                                    </button>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
}

@code {
    // Clave de pestaña para gestión de renovaciones pendientes.
    private const string TabRenovaciones = "renovaciones";

    // Clave de pestaña para creación y listado de pases por evento.
    private const string TabPasesEvento = "pases-evento";

    // Clave de pestaña para administración y revocación de tokens globales.
    private const string TabTokens = "tokens";

    // Clave de pestaña para seguimiento de incidencias ITIL 4.
    private const string TabIncidencias = "incidencias";

    // Clave de pestaña para monitoreo y sincronización de la cola offline.
    private const string TabSync = "sync";

    // Clave de pestaña para aprovisionamiento y directorio de usuarios institucionales.
    private const string TabUsuarios = "usuarios";

    // Pestaña actualmente visible dentro del panel administrativo.
    private string _tabActiva = TabRenovaciones;

    // Indica si el panel se encuentra cargando colecciones desde SQLite.
    private bool _cargando;

    // Indica si existe una operación administrativa de escritura en curso.
    private bool _procesandoAccion;

    // Mensaje de error seguro mostrado en la vista.
    private string? _mensajeError;

    // Mensaje actual de notificación toast Fiori.
    private string? _toastMensaje;

    // Variante visual semántica del toast activo.
    private string _toastVariante = "informative";

    // Listado de personas activas para selectores de pases y emisión de tokens.
    private IReadOnlyList<PersonaResumenDto> _personasActivas = Array.Empty<PersonaResumenDto>();

    // Listado de solicitudes de renovación en estado pendiente.
    private IReadOnlyList<SolicitudRenovacion> _renovacionesPendientes = Array.Empty<SolicitudRenovacion>();

    // Dictámenes de clasificación IA asociados a cada solicitud de renovación pendiente.
    private readonly Dictionary<int, ClasificacionVisitaResult> _dictamenesIaRenovacion = new();

    // Observaciones o motivos de rechazo capturados por solicitud de renovación.
    private readonly Dictionary<int, string> _observacionesRenovacion = new();

    // Listado global de pases por evento persistidos en SQLite.
    private IReadOnlyList<PaseEvento> _pasesEvento = Array.Empty<PaseEvento>();

    // Identificador de la persona seleccionada para el nuevo pase por evento.
    private int _eventoPersonaId;

    // Nombre oficial del evento institucional a emitir.
    private string _eventoNombre = string.Empty;

