    /// <summary>
    /// Valida el formulario de alta de usuario, persiste la cuenta en SQLite y recarga listados y selectores administrativos.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private async Task CrearUsuarioAsync()
    {
        if (!ValidarSesionAdministrativaUsuarios(out SesionUsuario? sesion))
        {
            return;
        }

        string nombre = _nuevoUsuarioNombre.Trim();
        string correo = _nuevoUsuarioCorreo.Trim();
        string? matricula = string.IsNullOrWhiteSpace(_nuevoUsuarioMatricula) ? null : _nuevoUsuarioMatricula.Trim();

        if (string.IsNullOrWhiteSpace(nombre))
        {
            _mensajeError = "El nombre completo del usuario es obligatorio.";
            return;
        }

        if (string.IsNullOrWhiteSpace(correo) || !correo.Contains('@'))
        {
            _mensajeError = "Ingresa un correo institucional válido.";
            return;
        }

        if (string.IsNullOrEmpty(_nuevoUsuarioPassword) || _nuevoUsuarioPassword.Length < 8)
        {
            _mensajeError = "La contraseña inicial debe tener al menos 8 caracteres.";
            return;
        }

        if (!string.Equals(_nuevoUsuarioPassword, _nuevoUsuarioConfirmarPassword, StringComparison.Ordinal))
        {
            _mensajeError = "La confirmación de contraseña no coincide.";
            return;
        }

        _procesandoAccion = true;
        _mensajeError = null;

        try
        {
            CrearUsuarioRequest solicitud = new()
            {
                NombreCompleto = nombre,
                Correo = correo,
                Matricula = matricula,
                Password = _nuevoUsuarioPassword,
                Rol = _nuevoUsuarioRol,
                EmitirTokenInicial = _nuevoUsuarioEmitirTokenInicial,
                TipoPaseInicial = _nuevoUsuarioTipoPaseInicial
            };

            UsuarioDetalleDto creado = await GestionUsuariosService.CrearUsuarioAsync(solicitud, sesion!.PersonaId);

            _nuevoUsuarioNombre = string.Empty;
            _nuevoUsuarioCorreo = string.Empty;
            _nuevoUsuarioMatricula = string.Empty;
            _nuevoUsuarioRol = RolPersona.Estudiante;
            _nuevoUsuarioPassword = string.Empty;
            _nuevoUsuarioConfirmarPassword = string.Empty;
            _nuevoUsuarioEmitirTokenInicial = true;
            _nuevoUsuarioTipoPaseInicial = TipoPase.Permanente;

            await CargarDatosPanelAsync();

            string sufijoPase = solicitud.EmitirTokenInicial
                ? $" con pase QR inicial ({solicitud.TipoPaseInicial})."
                : ".";

            MostrarToast(
                $"Usuario '{creado.NombreCompleto}' ({ObtenerEtiquetaRolPersona(creado.Rol)}) creado correctamente{sufijoPase}",
                "positive");
        }
        catch (UnauthorizedAccessException ex)
        {
            _mensajeError = ex.Message;
            MostrarToast(ex.Message, "negative");
        }
        catch (Exception ex)
        {
            _mensajeError = ex.Message;
            MostrarToast("No fue posible crear el usuario solicitado.", "negative");
        }
        finally
        {
            _procesandoAccion = false;
        }
    }

    /// <summary>
    /// Actualiza el rol institucional asignado a un usuario existente validando privilegios de administrador.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private async Task ActualizarRolUsuarioAsync(int usuarioId)
    {
        if (!ValidarSesionAdministrativaUsuarios(out SesionUsuario? sesion))
        {
            return;
        }

        if (!_rolesSeleccionadosPorUsuario.TryGetValue(usuarioId, out RolPersona nuevoRol))
        {
            return;
        }

        _procesandoAccion = true;
        _mensajeError = null;

        try
        {
            UsuarioDetalleDto actualizado = await GestionUsuariosService.ActualizarRolUsuarioAsync(
                usuarioId,
                nuevoRol,
                sesion!.PersonaId);

            await CargarDatosPanelAsync();
            MostrarToast(
                $"Rol de '{actualizado.NombreCompleto}' actualizado a {ObtenerEtiquetaRolPersona(actualizado.Rol)}.",
                "positive");
        }
        catch (UnauthorizedAccessException ex)
        {
            _mensajeError = ex.Message;
            MostrarToast(ex.Message, "negative");
        }
        catch (Exception ex)
        {
            _mensajeError = ex.Message;
            MostrarToast("No fue posible actualizar el rol del usuario.", "negative");
            SincronizarRolesSeleccionadosUsuarios();
        }
        finally
        {
            _procesandoAccion = false;
        }
    }

    /// <summary>
    /// Activa o desactiva la cuenta de un usuario institucional impidiendo la autodesactivación del administrador autenticado.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private async Task ActualizarEstadoUsuarioAsync(int usuarioId, bool activo)
    {
        if (!ValidarSesionAdministrativaUsuarios(out SesionUsuario? sesion))
        {
            return;
        }

        if (usuarioId == sesion!.PersonaId && !activo)
        {
            _mensajeError = "No puedes desactivar tu propia cuenta administradora mientras operas el panel.";
            MostrarToast(_mensajeError, "critical");
            return;
        }

        _procesandoAccion = true;
        _mensajeError = null;

        try
        {
            UsuarioDetalleDto actualizado = await GestionUsuariosService.ActualizarEstadoUsuarioAsync(
                usuarioId,
                activo,
                sesion.PersonaId);

            await CargarDatosPanelAsync();
            MostrarToast(
                actualizado.Activo
                    ? $"Cuenta de '{actualizado.NombreCompleto}' reactivada correctamente."
                    : $"Cuenta de '{actualizado.NombreCompleto}' desactivada correctamente.",
                actualizado.Activo ? "positive" : "informative");
        }
        catch (UnauthorizedAccessException ex)
        {
            _mensajeError = ex.Message;
            MostrarToast(ex.Message, "negative");
        }
        catch (Exception ex)
        {
            _mensajeError = ex.Message;
            MostrarToast("No fue posible actualizar el estado de la cuenta.", "negative");
        }
        finally
        {
            _procesandoAccion = false;
        }
    }

