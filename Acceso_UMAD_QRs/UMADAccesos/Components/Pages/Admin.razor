    /// <summary>
    /// Determina la clase CSS de MessageStrip correspondiente al resultado de un ciclo de sincronización.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private static string ObtenerClaseResultadoSync(SyncProcessResult resultado)
    {
        if (resultado.SinRed)
        {
            return "sap-messagestrip--warning";
        }

        if (resultado.Fallidos > 0)
        {
            return "sap-messagestrip--error";
        }

        return resultado.Exitosos > 0 ? "sap-messagestrip--success" : "sap-messagestrip--information";
    }

    /// <summary>
    /// Convierte una cadena capturada en datetime-local desde zona horaria institucional hacia UTC.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private static bool IntentarConvertirLocalAUtc(string valorLocal, out DateTime fechaUtc)
    {
        fechaUtc = default;
        if (string.IsNullOrWhiteSpace(valorLocal))
        {
            return false;
        }

        string[] formatos = { "yyyy-MM-ddTHH:mm", "yyyy-MM-ddTHH:mm:ss" };
        if (!DateTime.TryParseExact(
                valorLocal.Trim(),
                formatos,
                CultureInfo.InvariantCulture,
                DateTimeStyles.None,
                out DateTime localSinZona)
            && !DateTime.TryParse(valorLocal.Trim(), CultureInfo.InvariantCulture, DateTimeStyles.None, out localSinZona))
        {
            return false;
        }

        TimeZoneInfo zona = ResolverZonaHorariaInstitucional();
        DateTime localEspecifico = DateTime.SpecifyKind(localSinZona, DateTimeKind.Unspecified);
        fechaUtc = TimeZoneInfo.ConvertTimeToUtc(localEspecifico, zona);
        return true;
    }

    /// <summary>
    /// Obtiene la fecha y hora actual convertida a la zona horaria institucional UMAD.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private static DateTime ObtenerHoraActualInstitucional()
    {
        TimeZoneInfo zona = ResolverZonaHorariaInstitucional();
        return TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, zona);
    }

    /// <summary>
    /// Convierte una marca temporal UTC a zona horaria institucional para presentación consistente en pantalla.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private static string FormatearHoraLocal(DateTime fechaUtc)
    {
        DateTime normalizada = fechaUtc.Kind == DateTimeKind.Utc
            ? fechaUtc
            : (fechaUtc.Kind == DateTimeKind.Local
                ? fechaUtc.ToUniversalTime()
                : DateTime.SpecifyKind(fechaUtc, DateTimeKind.Utc));

        TimeZoneInfo zona = ResolverZonaHorariaInstitucional();
        return TimeZoneInfo.ConvertTimeFromUtc(normalizada, zona).ToString("dd/MM/yyyy HH:mm", CultureInfo.InvariantCulture);
    }

    /// <summary>
    /// Resuelve la zona horaria institucional (America/Mexico_City) con respaldo defensivo a la zona local del sistema.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private static TimeZoneInfo ResolverZonaHorariaInstitucional()
    {
        try
        {
            return TimeZoneInfo.FindSystemTimeZoneById("America/Mexico_City");
        }
        catch (Exception)
        {
            return TimeZoneInfo.Local;
        }
    }
}
