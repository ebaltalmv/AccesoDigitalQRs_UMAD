    /// <summary>
    /// Valida los campos del formulario y emite un pase por evento junto con su token QR acotado a la ventana UTC.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private async Task CrearPaseEventoAsync()
    {
        if (!ValidarPermisoAccion(PermisoSistema.GestionarPasesEvento, out SesionUsuario? sesion))
        {
            return;
        }

        if (_eventoPersonaId <= 0)
        {
            _mensajeError = "Seleccione una persona activa para emitir el pase por evento.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_eventoNombre))
        {
            _mensajeError = "El nombre del evento es obligatorio.";
            return;
        }

        if (!IntentarConvertirLocalAUtc(_eventoInicioLocalTexto, out DateTime inicioUtc)
            || !IntentarConvertirLocalAUtc(_eventoFinLocalTexto, out DateTime finUtc))
        {
            _mensajeError = "Capture fechas y horas válidas de inicio y fin para el evento.";
            return;
        }

        if (finUtc <= inicioUtc)
        {
            _mensajeError = "La fecha de fin del evento debe ser posterior a la fecha de inicio.";
            return;
        }

        if (finUtc <= DateTime.UtcNow)
        {
            _mensajeError = "La fecha de fin del evento debe ser posterior a la hora actual.";
            return;
        }

        _procesandoAccion = true;
        _mensajeError = null;

        try
        {
            PaseEvento paseCreado = await PaseEventoService.CrearPaseEventoAsync(
                _eventoNombre.Trim(),
                inicioUtc,
                finUtc,
                _eventoPersonaId,
                sesion!.PersonaId,
                string.IsNullOrWhiteSpace(_eventoDescripcion) ? null : _eventoDescripcion.Trim());

            _eventoNombre = string.Empty;
            _eventoDescripcion = string.Empty;
            InicializarVentanaEventoPorDefecto();

            await CargarDatosPanelAsync();
            MostrarToast(
                $"Pase de evento #{paseCreado.Id} creado con token QR #{paseCreado.TokenAccesoId}.",
                "positive");
        }
        catch (Exception ex)
        {
            _mensajeError = ex.Message;
            MostrarToast("No fue posible emitir el pase por evento.", "negative");
        }
        finally
        {
            _procesandoAccion = false;
        }
    }

    /// <summary>
    /// Emite administrativamente un nuevo token QR firmado para la persona y modalidad seleccionadas.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private async Task EmitirTokenAsync()
    {
        if (!ValidarPermisoAccion(PermisoSistema.RevocarTokens, out SesionUsuario? _))
        {
            return;
        }

        if (_tokenPersonaId <= 0)
        {
            _mensajeError = "Seleccione una persona activa para emitir un nuevo token.";
            return;
        }

        if (_tokenVigenciaHoras < 0)
        {
            _mensajeError = "La vigencia personalizada en horas no puede ser negativa.";
            return;
        }

        _procesandoAccion = true;
        _mensajeError = null;

        try
        {
            TimeSpan? vigencia = _tokenVigenciaHoras > 0
                ? TimeSpan.FromHours(_tokenVigenciaHoras)
                : null;

            TokenAcceso nuevoToken = await TokenAccesoService.EmitirTokenAsync(
                _tokenPersonaId,
                _tokenTipoPase,
                vigencia,
                _tokenRevocarPrevios);

            _tokenVigenciaHoras = 0;
            await CargarDatosPanelAsync();
            MostrarToast(
                $"Token #{nuevoToken.Id} ({nuevoToken.TipoPase}) emitido correctamente.",
                "positive");
        }
        catch (Exception ex)
        {
            _mensajeError = ex.Message;
            MostrarToast("No fue posible emitir el token de acceso.", "negative");
        }
        finally
        {
            _procesandoAccion = false;
        }
    }

    /// <summary>
    /// Revoca un token activo exigiendo motivo obligatorio y validación del administrador operador.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private async Task RevocarTokenAsync(int tokenId)
    {
        if (!ValidarPermisoAccion(PermisoSistema.RevocarTokens, out SesionUsuario? sesion))
        {
            return;
        }

        string motivo = ObtenerTextoDiccionario(_motivosRevocacion, tokenId).Trim();
        if (string.IsNullOrWhiteSpace(motivo))
        {
            _mensajeError = $"Debe ingresar un motivo obligatorio para revocar el token #{tokenId}.";
            MostrarToast(_mensajeError, "critical");
            return;
        }

        _procesandoAccion = true;
        _mensajeError = null;

        try
        {
            bool revocado = await TokenAccesoService.RevocarTokenAsync(
                tokenId,
                sesion!.PersonaId,
                motivo);

            _motivosRevocacion.Remove(tokenId);
            await CargarDatosPanelAsync();

            if (revocado)
            {
                MostrarToast($"Token #{tokenId} revocado correctamente.", "positive");
            }
            else
            {
                MostrarToast($"El token #{tokenId} ya se encontraba revocado o no existe.", "critical");
            }
        }
        catch (Exception ex)
        {
            _mensajeError = ex.Message;
            MostrarToast("No fue posible revocar el token seleccionado.", "negative");
        }
        finally
        {
            _procesandoAccion = false;
        }
    }

