    /// <summary>
    /// Convierte una fecha UTC a la zona horaria local America/Mexico_City para mostrarla al operador.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private static string FormatearHoraLocal(DateTime fechaUtc)
    {
        DateTime normalizada = fechaUtc.Kind switch
        {
            DateTimeKind.Utc => fechaUtc,
            DateTimeKind.Local => fechaUtc.ToUniversalTime(),
            _ => DateTime.SpecifyKind(fechaUtc, DateTimeKind.Utc)
        };

        TimeZoneInfo zona;
        try
        {
            zona = TimeZoneInfo.FindSystemTimeZoneById("America/Mexico_City");
        }
        catch (Exception)
        {
            zona = TimeZoneInfo.Local;
        }

        return TimeZoneInfo.ConvertTimeFromUtc(normalizada, zona).ToString("dd/MM/yyyy HH:mm");
    }

    /// <summary>
    /// Agrupa el detalle completo mostrado en la tarjeta de resultado en vivo tras validar un QR en caseta.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private sealed class ResultadoOperacionCaseta
    {
        // Indica si el acceso fue autorizado o denegado.
        public bool Autorizado { get; init; }

        // Identificador del registro persistido en SQLite cuando existió titular válido.
        public int? RegistroAccesoId { get; init; }

        // Identificador de la entrada abierta vinculada cuando se registró una salida.
        public int? EntradaRelacionadaId { get; init; }

        // Dirección del movimiento evaluado en caseta.
        public TipoMovimientoAcceso TipoMovimiento { get; init; }

        // Punto de acceso donde se realizó la validación.
        public string PuntoAcceso { get; init; } = string.Empty;

        // Fecha y hora UTC exacta de la operación.
        public DateTime FechaHoraUtc { get; init; } = DateTime.UtcNow;

        // Nombre completo del titular asociado al pase.
        public string NombrePersona { get; init; } = string.Empty;

        // Matrícula institucional del titular cuando aplica.
        public string? MatriculaPersona { get; init; }

        // Etiqueta del rol institucional del titular.
        public string RolPersonaTexto { get; init; } = string.Empty;

        // Etiqueta de la modalidad de pase validada.
        public string TipoPaseTexto { get; init; } = string.Empty;

        // Motivo exacto de autorización o rechazo devuelto por el servicio.
        public string Motivo { get; init; } = string.Empty;

        // Etiqueta del estado de sincronización offline del registro.
        public string EstadoSyncTexto { get; init; } = "Pendiente de sync";

        // Variante visual Fiori asociada al estado de sincronización.
        public string EstadoSyncVariante { get; init; } = "critical";

        // Indica si se adjuntó evidencia fotográfica al registro persistido.
        public bool TieneEvidenciaAdjunta { get; init; }

        // Resultado de la evaluación de anomalías IA asociada al intento.
        public EvaluacionAnomaliaResult? EvaluacionAnomalia { get; init; }

        // Indica si se recomienda escalar el evento a una incidencia ITIL.
        public bool SugerirIncidencia { get; init; }

        // Severidad ITIL recomendada en caso de prellenar una incidencia.
        public SeveridadIncidencia SeveridadSugerida { get; init; } = SeveridadIncidencia.Baja;
    }

    /// <summary>
    /// Encapsula los campos validables del formulario rápido de incidencias ITIL en caseta.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private sealed class FormularioIncidenciaModel
    {
        // Título breve y obligatorio de la incidencia reportada.
        [Required(ErrorMessage = "El título de la incidencia es obligatorio.")]
        [StringLength(200, MinimumLength = 5, ErrorMessage = "Ingresa un título entre 5 y 200 caracteres.")]
        public string Titulo { get; set; } = string.Empty;

        // Nivel de severidad ITIL asignado al reporte.
        public SeveridadIncidencia Severidad { get; set; } = SeveridadIncidencia.Media;

        // Punto de acceso donde ocurrió la incidencia.
        public string PuntoAcceso { get; set; } = "Caseta Principal";

        // Descripción detallada de los hechos observados en caseta.
        [Required(ErrorMessage = "La descripción de la incidencia es obligatoria.")]
        [StringLength(1800, MinimumLength = 10, ErrorMessage = "Describe los hechos con entre 10 y 1800 caracteres.")]
        public string Descripcion { get; set; } = string.Empty;

        // Indica si se debe vincular el reporte al último registro de acceso generado en la vista.
        public bool VincularUltimoRegistro { get; set; } = true;

        // Indica si se debe adjuntar la evidencia fotográfica actualmente capturada.
        public bool AdjuntarEvidenciaActual { get; set; } = true;
    }
