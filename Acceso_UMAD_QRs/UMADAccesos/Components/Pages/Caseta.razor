    }

    /// <summary>
    /// Limpia el campo de código QR y la tarjeta de resultado en vivo para preparar el siguiente turno de lectura.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private void LimpiarValidacionActual()
    {
        _codigoQrInput = string.Empty;
        _resultadoOperacion = null;
        _avisoEscaner = null;
        _mensajeErrorGeneral = null;
    }

    /// <summary>
    /// Precarga el formulario de incidencias ITIL con la información del último acceso denegado o alerta de anomalía IA.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private void PrellenarIncidenciaDesdeResultado()
    {
        if (_resultadoOperacion is null)
        {
            return;
        }

        string reglas = _resultadoOperacion.EvaluacionAnomalia?.ReglasActivadas.Count > 0
            ? string.Join(" | ", _resultadoOperacion.EvaluacionAnomalia.ReglasActivadas)
            : "Sin reglas adicionales.";

        _formularioIncidencia = new FormularioIncidenciaModel
        {
            Titulo = _resultadoOperacion.Autorizado
                ? $"Alerta de anomalía IA en {_resultadoOperacion.PuntoAcceso}"
                : $"Acceso denegado en {_resultadoOperacion.PuntoAcceso} ({_resultadoOperacion.NombrePersona})",
            Severidad = _resultadoOperacion.SeveridadSugerida,
            PuntoAcceso = _resultadoOperacion.PuntoAcceso,
            Descripcion = $"Titular: {_resultadoOperacion.NombrePersona}. Motivo: {_resultadoOperacion.Motivo}. Hallazgos IA: {reglas}",
            VincularUltimoRegistro = _resultadoOperacion.RegistroAccesoId.HasValue,
            AdjuntarEvidenciaActual = _evidenciaActual is not null
        };

        MostrarToast("Formulario de incidencia ITIL prellenado con la alerta detectada.", "informative");
    }

    /// <summary>
    /// Registra una nueva incidencia operativa ITIL en SQLite y refresca el listado de incidencias abiertas.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private async Task ReportarIncidenciaAsync()
    {
        SesionUsuario? sesion = SesionActual.SesionActual;
        if (sesion is null || !TieneAccesoCaseta(sesion))
        {
            MostrarToast("No cuentas con autorización para reportar incidencias.", "negative");
            return;
        }

        _reportandoIncidencia = true;
        _mensajeErrorGeneral = null;

        try
        {
            string descripcionCompleta = $"[Punto: {_formularioIncidencia.PuntoAcceso}] {_formularioIncidencia.Descripcion.Trim()}";
            int? registroVinculado = _formularioIncidencia.VincularUltimoRegistro ? _ultimoRegistroAccesoId : null;
            string? rutaFoto = _formularioIncidencia.AdjuntarEvidenciaActual ? _evidenciaActual?.RutaRelativa : null;
            string? hashFoto = _formularioIncidencia.AdjuntarEvidenciaActual ? _evidenciaActual?.HashSha256 : null;

            await IncidenciaService.ReportarIncidenciaAsync(
                sesion.PersonaId,
                _formularioIncidencia.Severidad,
                _formularioIncidencia.Titulo,
                descripcionCompleta,
                registroVinculado,
                rutaFoto,
                hashFoto);

            _formularioIncidencia = new FormularioIncidenciaModel
            {
                PuntoAcceso = _puntoAcceso
            };

            _incidenciasAbiertas = await IncidenciaService.ObtenerAbiertasAsync();
            _resumenCola = await SyncQueueService.ObtenerResumenColaAsync();
            MostrarToast("Incidencia ITIL registrada en SQLite y encolada para seguimiento.", "positive");
        }
        catch (Exception ex)
        {
            _mensajeErrorGeneral = $"No fue posible reportar la incidencia: {ex.Message}";
            MostrarToast("Verifica los campos de la incidencia e intenta nuevamente.", "negative");
        }
        finally
        {
            _reportandoIncidencia = false;
        }
    }

