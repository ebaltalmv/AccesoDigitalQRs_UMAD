    /// <summary>
    /// Evalúa mediante IAutorizacionRolService si la sesión vigente tiene permisos de autoservicio de Comunidad UMAD.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private bool TieneAccesoComunidad(SesionUsuario sesion)
    {
        return AutorizacionRol.TienePermiso(sesion.RolOperativo, PermisoSistema.ConsultarPropiosPases)
            || AutorizacionRol.TienePermiso(sesion.RolOperativo, PermisoSistema.SolicitarPaseORenovacion);
    }

    /// <summary>
    /// Consulta en SQLite los tokens activos, renovaciones y pases por evento pertenecientes al usuario autenticado.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private async Task CargarDatosComunidadAsync()
    {
        _cargando = true;
        _mensajeError = null;

        try
        {
            await DbInitializer.InitializeAsync();
            SesionUsuario? sesion = SesionActual.SesionActual;
            if (sesion is null || !TieneAccesoComunidad(sesion))
            {
                _tokensActivos = Array.Empty<TokenAcceso>();
                _tokenMostrado = null;
                _misRenovaciones = Array.Empty<SolicitudRenovacion>();
                _misPasesEvento = Array.Empty<PaseEvento>();
                return;
            }

            _tokensActivos = await TokenAccesoService.ObtenerTokensActivosPorPersonaAsync(sesion.PersonaId);
            _misRenovaciones = await AccesoConsultaService.ObtenerRenovacionesPorPersonaAsync(sesion.PersonaId);
            _misPasesEvento = await AccesoConsultaService.ObtenerPasesEventoAsync(sesion.PersonaId);

            if (_tokenMostrado is not null)
            {
                TokenAcceso? coincidente = _tokensActivos.FirstOrDefault(t => t.Id == _tokenMostrado.Id);
                _tokenMostrado = coincidente ?? _tokensActivos.FirstOrDefault();
            }
            else
            {
                _tokenMostrado = _tokensActivos.FirstOrDefault();
            }
        }
        catch (Exception)
        {
            _mensajeError = "No fue posible consultar tus pases y solicitudes desde la base local SQLite.";
        }
        finally
        {
            _cargando = false;
        }
    }

    /// <summary>
    /// Emite un nuevo token QR firmado HMAC-SHA256 o regenera el pase vigente del usuario autenticado.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private async Task EmitirORegenerarTokenAsync()
    {
        SesionUsuario? sesion = SesionActual.SesionActual;
        if (sesion is null || !AutorizacionRol.TienePermiso(sesion.RolOperativo, PermisoSistema.ConsultarPropiosPases))
        {
            MostrarToast("No cuentas con autorización para emitir un pase QR.", "negative");
            return;
        }

        _emitiendoToken = true;
        _mensajeError = null;

        try
        {
            TipoPase tipoDestino = _tokenMostrado?.TipoPase
                ?? (sesion.RolInstitucional == RolPersona.Visitante ? TipoPase.Visitante : TipoPase.Temporal);

            TokenAcceso nuevoToken = await TokenAccesoService.EmitirTokenAsync(
                sesion.PersonaId,
                tipoDestino,
                vigencia: null,
                revocarPreviosActivos: true);

            await CargarDatosComunidadAsync();
            _tokenMostrado = _tokensActivos.FirstOrDefault(t => t.Id == nuevoToken.Id) ?? nuevoToken;
            MostrarToast("Pase QR firmado emitido correctamente y guardado en SQLite local.", "positive");
        }
        catch (Exception ex)
        {
            _mensajeError = $"No fue posible emitir el pase QR: {ex.Message}";
            MostrarToast("Ocurrió un problema al emitir el pase QR.", "negative");
        }
        finally
        {
            _emitiendoToken = false;
        }
    }

