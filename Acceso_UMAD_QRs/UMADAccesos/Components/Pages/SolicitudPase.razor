    /// <summary>
    /// Normaliza una fecha al tipo DateTimeKind.Utc para comparaciones consistentes.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private static DateTime NormalizarUtc(DateTime fecha) => fecha.Kind switch
    {
        DateTimeKind.Utc => fecha,
        DateTimeKind.Local => fecha.ToUniversalTime(),
        _ => DateTime.SpecifyKind(fecha, DateTimeKind.Utc)
    };

    /// <summary>
    /// Convierte una fecha UTC a la zona horaria institucional America/Mexico_City para presentación local.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private static string FormatearHoraLocal(DateTime fechaUtc)
    {
        DateTime normalizada = NormalizarUtc(fechaUtc);
        TimeZoneInfo zona;
        try
        {
            zona = TimeZoneInfo.FindSystemTimeZoneById("America/Mexico_City");
        }
        catch (Exception)
        {
            zona = TimeZoneInfo.Local;
        }

        return TimeZoneInfo.ConvertTimeFromUtc(normalizada, zona).ToString("dd/MM/yyyy HH:mm");
    }

