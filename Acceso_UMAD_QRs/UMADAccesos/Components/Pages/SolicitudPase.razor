    /// <summary>
    /// Registra la solicitud de renovación en SQLite mediante IRenovacionService y actualiza el historial del usuario.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private async Task EnviarSolicitudRenovacionAsync()
    {
        SesionUsuario? sesion = SesionActual.SesionActual;
        if (sesion is null || !AutorizacionRol.TienePermiso(sesion.RolOperativo, PermisoSistema.SolicitarPaseORenovacion))
        {
            MostrarToast("No cuentas con autorización para registrar solicitudes de renovación.", "negative");
            return;
        }

        _enviandoRenovacion = true;
        _mensajeError = null;

        try
        {
            TimeSpan? vigenciaSolicitada = ResolverVigenciaSolicitada(_formularioRenovacion.VigenciaOpcion);

            await RenovacionService.SolicitarRenovacionAsync(
                sesion.PersonaId,
                _formularioRenovacion.TipoPaseDeseado,
                _formularioRenovacion.Justificacion,
                vigenciaSolicitada);

            _formularioRenovacion = new FormularioRenovacionModel
            {
                TipoPaseDeseado = _formularioRenovacion.TipoPaseDeseado
            };
            _resultadoIaMotivo = null;

            _misRenovaciones = await AccesoConsultaService.ObtenerRenovacionesPorPersonaAsync(sesion.PersonaId);
            MostrarToast("Solicitud de renovación registrada en SQLite y encolada para revisión administrativa.", "positive");
        }
        catch (Exception ex)
        {
            _mensajeError = $"No fue posible registrar la solicitud de renovación: {ex.Message}";
            MostrarToast("Verifica los campos de la solicitud e intenta nuevamente.", "negative");
        }
        finally
        {
            _enviandoRenovacion = false;
        }
    }

