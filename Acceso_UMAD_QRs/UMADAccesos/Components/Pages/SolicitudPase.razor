@page "/solicitud-pase"
@implements IDisposable
@inject ISesionActualService SesionActual
@inject IAutorizacionRolService AutorizacionRol
@inject IUmadDbInitializer DbInitializer
@inject ITokenAccesoService TokenAccesoService
@inject IRenovacionService RenovacionService
@inject IAccesoConsultaService AccesoConsultaService
@inject IIaService IaService

<ToastNotification Message="@_toastMensaje" Variant="@_toastVariante" OnDismiss="CerrarToast" />

@if (!SesionActual.EstaAutenticado || SesionActual.SesionActual is null)
{
    <section class="fiori-card">
        <div class="fiori-card-header">
            <div>
                <h2 class="fiori-card-title">Autenticación requerida · Comunidad UMAD</h2>
                <p class="fiori-page-subtitle">
                    Inicia sesión con tu cuenta institucional para consultar tu pase QR digital, solicitar renovaciones y ver tus pases por evento.
                </p>
            </div>
            <StatusBadge Text="Sin sesión" Variant="critical" />
        </div>

        <div class="sap-messagestrip sap-messagestrip--information">
            <span>Por seguridad institucional, los pases QR firmados solo están disponibles para usuarios autenticados.</span>
        </div>

        <div class="fiori-actions-row">
            <a href="/login" class="fiori-btn fiori-btn--emphasized">Iniciar sesión</a>
            <a href="/" class="fiori-btn fiori-btn--standard">Volver al inicio</a>
        </div>
    </section>
}
else if (!TieneAccesoComunidad(SesionActual.SesionActual))
{
    <section class="fiori-card">
        <div class="fiori-card-header">
            <div>
                <h2 class="fiori-card-title">Acceso restringido por control de roles (RBAC)</h2>
                <p class="fiori-page-subtitle">
                    Esta vista pertenece al portal de Comunidad UMAD (estudiantes, docentes, administrativos y visitantes).
                </p>
            </div>
            <StatusBadge Text="RBAC Activo" Variant="negative" />
        </div>

        <div class="sap-messagestrip sap-messagestrip--warning">
            <span>
                Tu rol operativo actual (<strong>@ObtenerEtiquetaRol(SesionActual.SesionActual.RolOperativo)</strong>)
                no incluye permisos de autoservicio de pases de comunidad. Utiliza los módulos asignados a tu rol.
            </span>
        </div>

        <div class="fiori-actions-row">
            <a href="/" class="fiori-btn fiori-btn--emphasized">Volver al panel principal</a>
            @if (SesionActual.SesionActual.RolOperativo == RolUsuario.GuardiaSeguridad)
            {
                <a href="/caseta" class="fiori-btn fiori-btn--standard">Ir a Caseta de Vigilancia</a>
            }
            else if (SesionActual.SesionActual.RolOperativo == RolUsuario.AdministradorAccesos)
            {
                <a href="/admin" class="fiori-btn fiori-btn--standard">Ir a Panel de Administración</a>
            }
        </div>
    </section>
}
else
{
    SesionUsuario sesion = SesionActual.SesionActual;

    <div class="fiori-page-header">
        <div>
            <h1 class="fiori-page-title">Mi Pase QR y Solicitudes</h1>
            <p class="fiori-page-subtitle">
                @sesion.NombreCompleto · @sesion.Correo
                @if (!string.IsNullOrWhiteSpace(sesion.Matricula))
                {
                    <span> · Matrícula: @sesion.Matricula</span>
                }
            </p>
        </div>
        <div class="fiori-actions-row">
            <StatusBadge Text="@ObtenerEtiquetaRolInstitucional(sesion.RolInstitucional)" Variant="informative" />
            <StatusBadge Text="@($"IA: {ObtenerEtiquetaModoIa(IaService.ModoActivo)}")" Variant="neutral" />
            <button type="button"
                    class="fiori-btn fiori-btn--standard fiori-btn--compact"
                    @onclick="CargarDatosComunidadAsync"
                    disabled="@_cargando">
                @(_cargando ? "Actualizando..." : "Actualizar vista")
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_mensajeError))
    {
        <div class="sap-messagestrip sap-messagestrip--error" role="alert">
            <span>@_mensajeError</span>
        </div>
    }

    <!-- Sección 1: Mi Pase QR Digital -->
    <section class="fiori-card">
        <div class="fiori-card-header">
            <div>
                <h2 class="fiori-card-title">1. Mi Pase QR Digital</h2>
                <p class="fiori-page-subtitle">
                    Credencial firmada criptográficamente con HMAC-SHA256 lista para validación en caseta incluso en modo offline.
                </p>
            </div>
            @if (_tokenMostrado is not null)
            {
                <StatusBadge Text="@ObtenerTextoVigenciaToken(_tokenMostrado)" Variant="@ObtenerVarianteVigenciaToken(_tokenMostrado)" />
            }
            else
            {
                <StatusBadge Text="Sin pase activo" Variant="neutral" />
            }
        </div>

        @if (_tokenMostrado is null)
        {
            <div class="fiori-empty-state">
                <p style="margin:0 0 0.75rem 0; font-weight:600; color:var(--sapTextColor);">
                    Aún no cuentas con un pase QR activo en este dispositivo.
                </p>
                <p style="margin:0 0 1rem 0; font-size:0.88rem;">
                    Emite tu credencial digital firmada para presentarla en los puntos de control de acceso UMAD.
                </p>
                <button type="button"
                        class="fiori-btn fiori-btn--emphasized"
                        @onclick="EmitirORegenerarTokenAsync"
                        disabled="@_emitiendoToken">
                    @(_emitiendoToken ? "Emitiendo pase..." : "Emitir mi pase QR")
                </button>
            </div>
        }
        else
        {
            <div class="fiori-grid fiori-grid--2" style="align-items:center;">
                <div style="display:flex; flex-direction:column; align-items:center; gap:0.75rem;">
                    <div class="fiori-qr-frame">
                        <QrCodeSvg Payload="@_tokenMostrado.CodigoFirmado"
                                   Size="230"
                                   AriaLabel="@($"Código QR de acceso {ObtenerEtiquetaTipoPase(_tokenMostrado.TipoPase)} de {sesion.NombreCompleto}")" />
                        <span style="margin-top:0.55rem; font-size:0.78rem; font-weight:700; color:var(--umadNavy);">
                            @ObtenerEtiquetaTipoPase(_tokenMostrado.TipoPase) · Folio @(_tokenMostrado.IdentificadorGlobal.ToString("N")[..8].ToUpperInvariant())
                        </span>
                    </div>

                    @if (_tokensActivos.Count > 1)
                    {
                        <div class="fiori-actions-row" style="justify-content:center;">
                            @foreach (TokenAcceso tokenItem in _tokensActivos)
                            {
                                bool seleccionado = tokenItem.Id == _tokenMostrado.Id;
                                <button type="button"
                                        class="fiori-btn fiori-btn--compact @(seleccionado ? "fiori-btn--emphasized" : "fiori-btn--standard")"
                                        @onclick="() => SeleccionarTokenMostrado(tokenItem)">
                                    @ObtenerEtiquetaTipoPase(tokenItem.TipoPase) #@tokenItem.Id
                                </button>
                            }
                        </div>
                    }
                </div>

                <div>
                    <div class="fiori-grid fiori-grid--2" style="margin-bottom:1rem;">
                        <div class="fiori-kpi">
                            <span class="fiori-kpi-label">Tipo de pase</span>
                            <span class="fiori-kpi-value" style="font-size:1.2rem;">@ObtenerEtiquetaTipoPase(_tokenMostrado.TipoPase)</span>
                            <span class="fiori-kpi-sub">Titular: @sesion.NombreCompleto</span>
                        </div>
                        <div class="fiori-kpi">
                            <span class="fiori-kpi-label">Estado de firma</span>
                            <span class="fiori-kpi-value" style="font-size:1.2rem;">HMAC-SHA256</span>
                            <span class="fiori-kpi-sub">Clave protegida en dispositivo</span>
                        </div>
                        <div class="fiori-kpi">
                            <span class="fiori-kpi-label">Fecha de emisión</span>
                            <span class="fiori-kpi-value" style="font-size:1.05rem;">@FormatearHoraLocal(_tokenMostrado.FechaEmision)</span>
                            <span class="fiori-kpi-sub">Hora local (Ciudad de México)</span>
                        </div>
                        <div class="fiori-kpi">
                            <span class="fiori-kpi-label">Vigencia hasta</span>
                            <span class="fiori-kpi-value" style="font-size:1.05rem;">@FormatearHoraLocal(_tokenMostrado.FechaExpiracion)</span>
                            <span class="fiori-kpi-sub">@ObtenerTiempoRestanteTexto(_tokenMostrado.FechaExpiracion)</span>
                        </div>
                    </div>

                    <div class="sap-messagestrip sap-messagestrip--information" style="margin-bottom:0.85rem;">
                        <span>
                            Por seguridad, la cadena criptográfica no se muestra en pantalla. Para demostraciones en equipos sin cámara,
                            puedes copiar el código firmado al portapapeles y pegarlo directamente en la vista de Caseta.
                        </span>
                    </div>

                    <div class="fiori-actions-row">
                        <button type="button"
                                class="fiori-btn fiori-btn--emphasized"
                                @onclick="() => CopiarCodigoFirmadoAsync(_tokenMostrado.CodigoFirmado)"
                                disabled="@_copiandoCodigo">
                            @(_copiandoCodigo ? "Copiando..." : "Copiar código para prueba en caseta")
                        </button>
                        <button type="button"
                                class="fiori-btn fiori-btn--standard"
                                @onclick="EmitirORegenerarTokenAsync"
                                disabled="@_emitiendoToken">
                            @(_emitiendoToken ? "Regenerando..." : "Regenerar pase QR")
                        </button>
                    </div>
                </div>
            </div>
        }
    </section>

    <!-- Sección 2: Solicitar Renovación con Asistencia de IA -->
    <section class="fiori-card">
        <div class="fiori-card-header">
            <div>
                <h2 class="fiori-card-title">2. Solicitar Renovación con Asistencia de IA</h2>
                <p class="fiori-page-subtitle">
                    Describe tu motivo de renovación o cambio de modalidad y analiza su clasificación institucional antes de enviar la solicitud.
                </p>
            </div>
            <StatusBadge Text="@($"Solicitudes registradas: {_misRenovaciones.Count}")" Variant="informative" />
        </div>

        <EditForm Model="_formularioRenovacion" OnValidSubmit="EnviarSolicitudRenovacionAsync">
            <DataAnnotationsValidator />

            <div class="fiori-grid fiori-grid--2">
                <div class="fiori-form-group">
                    <label class="fiori-label" for="tipoPaseDeseado">Tipo de pase solicitado</label>
                    <InputSelect id="tipoPaseDeseado" class="fiori-select" @bind-Value="_formularioRenovacion.TipoPaseDeseado">
                        <option value="@TipoPase.Permanente">Permanente (Comunidad activa · 30 días)</option>
                        <option value="@TipoPase.Temporal">Temporal (Provisional · 7 días)</option>
                        <option value="@TipoPase.Visitante">Visitante (Acceso por jornada · 12 horas)</option>
                        <option value="@TipoPase.Evento">Evento (Actividad institucional · 24 horas)</option>
                    </InputSelect>
                </div>

                <div class="fiori-form-group">
                    <label class="fiori-label" for="vigenciaSolicitada">Vigencia solicitada (opcional)</label>
                    <InputSelect id="vigenciaSolicitada" class="fiori-select" @bind-Value="_formularioRenovacion.VigenciaOpcion">
                        <option value="default">Vigencia institucional por defecto</option>
                        <option value="12h">12 horas</option>
                        <option value="24h">24 horas</option>
                        <option value="7d">7 días</option>
                        <option value="30d">30 días</option>
                        <option value="90d">90 días</option>
                    </InputSelect>
                </div>
            </div>

            <div class="fiori-form-group">
                <label class="fiori-label" for="justificacionRenovacion">Motivo o justificación de la solicitud</label>
                <InputTextArea id="justificacionRenovacion"
                               class="fiori-textarea"
                               maxlength="500"
                               placeholder="Ejemplo: Renovación semestral de acceso para clases en laboratorio de ingeniería y asesorías académicas..."
                               @bind-Value="_formularioRenovacion.Justificacion" />
                <ValidationMessage For="@(() => _formularioRenovacion.Justificacion)" />
                <span style="font-size:0.78rem; color:var(--sapSecondaryTextColor);">
                    @((_formularioRenovacion.Justificacion?.Length ?? 0))/500 caracteres · Los datos se guardan en SQLite local y se encolan para sincronización.
                </span>
            </div>

            <div class="fiori-actions-row" style="margin-bottom:1rem;">
                @if (AutorizacionRol.TienePermiso(sesion.RolOperativo, PermisoSistema.ClasificarMotivoVisitaIa))
                {
                    <button type="button"
                            class="fiori-btn fiori-btn--standard"
                            @onclick="AnalizarMotivoConIaAsync"
                            disabled="@(_analizandoIa || string.IsNullOrWhiteSpace(_formularioRenovacion.Justificacion))">
                        @(_analizandoIa ? "Analizando con IA..." : "Analizar motivo con IA")
                    </button>
                }

                <button type="submit"
                        class="fiori-btn fiori-btn--emphasized"
                        disabled="@_enviandoRenovacion">
                    @(_enviandoRenovacion ? "Enviando solicitud..." : "Enviar solicitud de renovación")
                </button>
            </div>
        </EditForm>

        @if (_resultadoIaMotivo is not null)
        {
            <div class="fiori-card" style="background-color:#FAFBFD; margin-bottom:1.1rem;">
                <div class="fiori-card-header" style="margin-bottom:0.75rem; padding-bottom:0.5rem;">
                    <div>
                        <h3 class="fiori-card-title" style="font-size:0.96rem;">Resultado del Análisis de IA</h3>
                        <p class="fiori-page-subtitle" style="font-size:0.82rem;">
                            Proveedor: @_resultadoIaMotivo.ProveedorUtilizado · Modo activo: @ObtenerEtiquetaModoIa(IaService.ModoActivo)
                        </p>
                    </div>
                    <div class="fiori-actions-row">
                        <StatusBadge Text="@ObtenerEtiquetaTipoVisita(_resultadoIaMotivo.TipoVisitaSugerido)" Variant="informative" />
                        <StatusBadge Text="@(_resultadoIaMotivo.RequiereAprobacionEspecial ? "Requiere aprobación especial" : "Flujo estándar")"
                                     Variant="@(_resultadoIaMotivo.RequiereAprobacionEspecial ? "critical" : "positive")" />
                    </div>
                </div>

                <div class="fiori-grid fiori-grid--3" style="margin-bottom:0.75rem;">
                    <div class="fiori-kpi">
                        <span class="fiori-kpi-label">Clasificación sugerida</span>
                        <span class="fiori-kpi-value" style="font-size:1.1rem;">@ObtenerEtiquetaTipoVisita(_resultadoIaMotivo.TipoVisitaSugerido)</span>
                    </div>
                    <div class="fiori-kpi">
                        <span class="fiori-kpi-label">Área destino recomendada</span>
                        <span class="fiori-kpi-value" style="font-size:1.1rem;">@_resultadoIaMotivo.AreaDestinoSugerida</span>
                    </div>
                    <div class="fiori-kpi">
                        <span class="fiori-kpi-label">Nivel de confianza</span>
                        <span class="fiori-kpi-value" style="font-size:1.1rem;">@($"{Math.Round(_resultadoIaMotivo.NivelConfianza * 100):0}%")</span>
                    </div>
                </div>

                <p style="margin:0 0 0.5rem 0; font-size:0.9rem;">
                    <strong>Recomendación / dictamen:</strong> @_resultadoIaMotivo.Justificacion
                </p>

                @if (_resultadoIaMotivo.PalabrasClaveDetectadas.Count > 0)
                {
                    <div class="fiori-actions-row" style="margin-top:0.5rem;">
                        <span style="font-size:0.8rem; font-weight:600; color:var(--sapSecondaryTextColor);">Palabras clave:</span>
                        @foreach (string palabra in _resultadoIaMotivo.PalabrasClaveDetectadas)
                        {
                            <StatusBadge Text="@palabra" Variant="neutral" />
                        }
                    </div>
                }
            </div>
        }

        <h3 class="fiori-card-title" style="font-size:0.96rem; margin-bottom:0.65rem;">Mis solicitudes de renovación</h3>

        @if (_misRenovaciones.Count == 0)
        {
            <div class="fiori-empty-state">
                <p style="margin:0;">Todavía no has enviado solicitudes de renovación.</p>
            </div>
        }
        else
        {
            <div class="fiori-table-wrap">
                <table class="fiori-table">
                    <thead>
                        <tr>
                            <th>Fecha solicitud</th>
                            <th>Pase solicitado</th>
                            <th>Justificación</th>
                            <th>Estado</th>
                            <th>Resolución</th>
                            <th>Sync</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (SolicitudRenovacion solicitud in _misRenovaciones)
                        {
                            <tr>
                                <td style="white-space:nowrap;">@FormatearHoraLocal(solicitud.FechaSolicitudUtc)</td>
                                <td>
                                    <strong>@ObtenerEtiquetaTipoPase(solicitud.TipoPaseDeseado)</strong>
                                    @if (solicitud.VigenciaSolicitada.HasValue)
                                    {
                                        <div style="font-size:0.78rem; color:var(--sapSecondaryTextColor);">
                                            @FormatearDuracion(solicitud.VigenciaSolicitada.Value)
                                        </div>
                                    }
                                </td>
                                <td>@solicitud.Justificacion</td>
                                <td>
                                    <StatusBadge Text="@ObtenerEtiquetaEstadoRenovacion(solicitud.Estado)"
                                                 Variant="@ObtenerVarianteEstadoRenovacion(solicitud.Estado)" />
                                </td>
                                <td>
                                    @if (solicitud.FechaResolucionUtc.HasValue)
                                    {
                                        <div>@FormatearHoraLocal(solicitud.FechaResolucionUtc.Value)</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(solicitud.MotivoResolucion))
                                    {
                                        <div style="font-size:0.82rem; color:var(--sapSecondaryTextColor);">@solicitud.MotivoResolucion</div>
                                    }
                                    else if (solicitud.Estado == EstadoRenovacion.Aprobada && solicitud.TokenAccesoNuevoId.HasValue)
                                    {
                                        <div style="font-size:0.82rem; color:var(--sapPositiveColor);">Nuevo pase QR emitido (#@solicitud.TokenAccesoNuevoId)</div>
                                    }
                                    else
                                    {
                                        <span style="font-size:0.82rem; color:var(--sapSecondaryTextColor);">En revisión administrativa</span>
                                    }
                                </td>
                                <td>
                                    <StatusBadge Text="@ObtenerEtiquetaSync(solicitud.EstadoSincronizacion)"
                                                 Variant="@ObtenerVarianteSync(solicitud.EstadoSincronizacion)" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <!-- Sección 3: Mis Pases por Evento -->
    <section class="fiori-card">
        <div class="fiori-card-header">
            <div>
                <h2 class="fiori-card-title">3. Mis Pases por Evento</h2>
                <p class="fiori-page-subtitle">
                    Pases temporales asignados para congresos, conferencias y actividades institucionales en el campus UMAD.
                </p>
            </div>
            <StatusBadge Text="@($"Eventos asignados: {_misPasesEvento.Count}")" Variant="informative" />
        </div>

        @if (_misPasesEvento.Count == 0)
        {
            <div class="fiori-empty-state">
                <p style="margin:0;">No tienes pases por evento asignados actualmente.</p>
            </div>
        }
        else
        {
            <div class="fiori-table-wrap">
                <table class="fiori-table">
                    <thead>
                        <tr>
                            <th>Evento</th>
                            <th>Inicio vigencia</th>
                            <th>Fin vigencia</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (PaseEvento pase in _misPasesEvento)
                        {
                            <tr>
                                <td>
                                    <strong>@pase.NombreEvento</strong>
                                    @if (!string.IsNullOrWhiteSpace(pase.Descripcion))
                                    {
                                        <div style="font-size:0.82rem; color:var(--sapSecondaryTextColor);">@pase.Descripcion</div>
                                    }
                                </td>
                                <td style="white-space:nowrap;">@FormatearHoraLocal(pase.FechaInicioEvento)</td>
                                <td style="white-space:nowrap;">@FormatearHoraLocal(pase.FechaFinEvento)</td>
                                <td>
                                    <StatusBadge Text="@ObtenerEstadoPaseEventoTexto(pase)"
                                                 Variant="@ObtenerEstadoPaseEventoVariante(pase)" />
                                </td>
                                <td>
                                    @if (pase.TokenAcceso is not null && !pase.TokenAcceso.Revocado)
                                    {
                                        <div class="fiori-actions-row">
                                            <button type="button"
                                                    class="fiori-btn fiori-btn--standard fiori-btn--compact"
                                                    @onclick="() => SeleccionarTokenMostrado(pase.TokenAcceso)">
                                                Ver QR arriba
                                            </button>
                                            <button type="button"
                                                    class="fiori-btn fiori-btn--transparent fiori-btn--compact"
                                                    @onclick="() => CopiarCodigoFirmadoAsync(pase.TokenAcceso.CodigoFirmado)">
                                                Copiar código
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <span style="font-size:0.82rem; color:var(--sapSecondaryTextColor);">Sin QR disponible</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@code {
    // Indica si la vista está consultando SQLite para cargar pases, renovaciones y eventos.
    private bool _cargando;

    // Indica si se está emitiendo o regenerando el pase QR digital.
    private bool _emitiendoToken;

    // Indica si se está copiando el código firmado al portapapeles.
    private bool _copiandoCodigo;

    // Indica si el motor de IA está clasificando el motivo de la solicitud.
    private bool _analizandoIa;

    // Indica si la solicitud de renovación se está persistiendo en SQLite.
    private bool _enviandoRenovacion;

    // Mensaje de error seguro mostrado en la vista.
    private string? _mensajeError;

    // Mensaje mostrado en el componente ToastNotification.
    private string? _toastMensaje;

    // Variante semántica Fiori aplicada al toast activo.
    private string _toastVariante = "informative";

    // Colección de tokens vigentes del usuario autenticado.
    private IReadOnlyList<TokenAcceso> _tokensActivos = Array.Empty<TokenAcceso>();

    // Token actualmente visualizado dentro del marco del código QR.
    private TokenAcceso? _tokenMostrado;

    // Historial de solicitudes de renovación del usuario autenticado.
    private IReadOnlyList<SolicitudRenovacion> _misRenovaciones = Array.Empty<SolicitudRenovacion>();

    // Listado de pases por evento asignados al usuario autenticado.
    private IReadOnlyList<PaseEvento> _misPasesEvento = Array.Empty<PaseEvento>();

    // Modelo enlazado al formulario de nueva solicitud de renovación.
    private FormularioRenovacionModel _formularioRenovacion = new();

    // Resultado estructurado de la clasificación asistida por IA del motivo capturado.
    private ClasificacionVisitaResult? _resultadoIaMotivo;

    /// <summary>
    /// Inicializa la vista suscribiéndose al estado reactivo de sesión y cargando los datos de comunidad desde SQLite.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
