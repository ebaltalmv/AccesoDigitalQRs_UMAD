    private sealed class FormularioRenovacionModel
    {
        // Modalidad de pase deseada por el usuario solicitante.
        public TipoPase TipoPaseDeseado { get; set; } = TipoPase.Permanente;

        // Clave de duración solicitada seleccionada en el desplegable.
        public string VigenciaOpcion { get; set; } = "default";

        // Justificación obligatoria del motivo de renovación o cambio de pase.
        [Required(ErrorMessage = "La justificación de la solicitud es obligatoria.")]
