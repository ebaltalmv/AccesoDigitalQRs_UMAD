    /// <summary>
    /// Determina la etiqueta de vigencia mostrada en el badge principal del token QR.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private static string ObtenerTextoVigenciaToken(TokenAcceso token)
    {
        DateTime ahoraUtc = DateTime.UtcNow;
        DateTime emisionUtc = NormalizarUtc(token.FechaEmision);
        DateTime expiracionUtc = NormalizarUtc(token.FechaExpiracion);

        if (token.Revocado)
        {
            return "Revocado";
        }

        if (ahoraUtc < emisionUtc)
        {
            return "Programado";
        }

        if (expiracionUtc <= ahoraUtc)
        {
            return "Expirado";
        }

        return (expiracionUtc - ahoraUtc) <= TimeSpan.FromHours(24)
            ? "Próximo a vencer"
            : "Vigente";
    }

    /// <summary>
    /// Resuelve la variante visual Fiori del badge de vigencia del token QR.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private static string ObtenerVarianteVigenciaToken(TokenAcceso token)
    {
        DateTime ahoraUtc = DateTime.UtcNow;
        DateTime emisionUtc = NormalizarUtc(token.FechaEmision);
        DateTime expiracionUtc = NormalizarUtc(token.FechaExpiracion);

        if (token.Revocado || expiracionUtc <= ahoraUtc)
        {
            return "negative";
        }

        if (ahoraUtc < emisionUtc)
        {
            return "informative";
        }

        return (expiracionUtc - ahoraUtc) <= TimeSpan.FromHours(24)
            ? "critical"
            : "positive";
    }

    /// <summary>
    /// Calcula una descripción legible del tiempo restante de vigencia del token.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private static string ObtenerTiempoRestanteTexto(DateTime fechaExpiracionUtc)
    {
        TimeSpan restante = NormalizarUtc(fechaExpiracionUtc) - DateTime.UtcNow;
        if (restante <= TimeSpan.Zero)
        {
            return "Vigencia concluida";
        }

        if (restante.TotalDays >= 1)
        {
            return $"Restan {(int)restante.TotalDays} día(s) y {restante.Hours} h";
        }

        if (restante.TotalHours >= 1)
        {
            return $"Restan {(int)restante.TotalHours} h {restante.Minutes} min";
        }

        return $"Restan {Math.Max(1, restante.Minutes)} min";
    }

    /// <summary>
    /// Determina el texto de estado de vigencia para un pase por evento.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private static string ObtenerEstadoPaseEventoTexto(PaseEvento pase)
    {
        if (pase.TokenAcceso?.Revocado == true)
        {
            return "Revocado";
        }

        DateTime ahoraUtc = DateTime.UtcNow;
        DateTime inicioUtc = NormalizarUtc(pase.FechaInicioEvento);
        DateTime finUtc = NormalizarUtc(pase.FechaFinEvento);

        if (ahoraUtc < inicioUtc)
        {
            return "Programado";
        }

        if (ahoraUtc > finUtc)
        {
            return "Finalizado";
        }

        return "Vigente ahora";
    }

    /// <summary>
    /// Determina la variante visual Fiori correspondiente al estado actual de un pase por evento.
    /// </summary>
