    /// <summary>
    /// Genera una etiqueta concisa para la evaluación de anomalías IA.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private static string ObtenerEtiquetaAnomalia(EvaluacionAnomaliaResult evaluacion)
    {
        if (!evaluacion.EsAnomalo)
        {
            return "Normal";
        }

        return evaluacion.NivelRiesgo switch
        {
            NivelRiesgoAnomalia.Alto => "Anomalía Alta",
            NivelRiesgoAnomalia.Medio => "Riesgo Medio",
            _ => "Alerta Baja"
        };
    }

    /// <summary>
    /// Determina la variante semántica SAP Fiori del badge de anomalía IA.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private static string ObtenerVarianteAnomalia(EvaluacionAnomaliaResult evaluacion)
    {
        if (!evaluacion.EsAnomalo)
        {
            return "positive";
        }

        return evaluacion.NivelRiesgo switch
        {
            NivelRiesgoAnomalia.Alto => "negative",
            NivelRiesgoAnomalia.Medio => "critical",
            _ => "informative"
        };
    }

    /// <summary>
    /// Devuelve la clase visual del contenedor de anomalía según el nivel de riesgo dictaminado.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private static string ObtenerClaseCajaAnomalia(EvaluacionAnomaliaResult evaluacion)
    {
        if (!evaluacion.EsAnomalo)
        {
            return "fiori-anomaly-box--low";
        }

        return evaluacion.NivelRiesgo switch
        {
            NivelRiesgoAnomalia.Alto => "fiori-anomaly-box--high",
            NivelRiesgoAnomalia.Medio => "fiori-anomaly-box--medium",
            _ => "fiori-anomaly-box--low"
        };
    }

    /// <summary>
    /// Convierte una marca temporal UTC a hora local institucional de America/Mexico_City con respaldo determinista a UTC-6.
    /// </summary>
    /// <author>Emmanuel Baltazar López</author>
    /// <date>25/11/2026</date>
    /// <version>1.0</version>
    /// <modification>25/11/2026</modification>
    private static string FormatearHoraLocal(DateTime fechaUtc)
    {
        DateTime normalizada = fechaUtc.Kind == DateTimeKind.Utc
            ? fechaUtc
            : (fechaUtc.Kind == DateTimeKind.Local
                ? fechaUtc.ToUniversalTime()
                : DateTime.SpecifyKind(fechaUtc, DateTimeKind.Utc));

        TimeZoneInfo zona;
        try
        {
            zona = TimeZoneInfo.FindSystemTimeZoneById("America/Mexico_City");
        }
        catch (Exception)
        {
            zona = TimeZoneInfo.CreateCustomTimeZone("UMAD-UTC-6", TimeSpan.FromHours(-6), "UTC-6", "UTC-6");
        }

        return TimeZoneInfo.ConvertTimeFromUtc(normalizada, zona).ToString("dd/MM/yyyy HH:mm");
    }
