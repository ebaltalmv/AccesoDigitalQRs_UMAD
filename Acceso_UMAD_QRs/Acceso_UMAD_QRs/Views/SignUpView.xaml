<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Acceso_UMAD_QRs.ViewModels"
             x:Class="Acceso_UMAD_QRs.Views.SignUpView"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
             Title="User Registration">

    <ScrollView>
        <VerticalStackLayout Spacing="15"
                             Padding="25">

            <Label Text="Create your account"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                   HorizontalOptions="Center" />
            <Label Text="Your data will be sent to Administration to authorize your QR code."
                   FontSize="14"
                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,15" />

            <Entry Placeholder="Full Name (Required)"
                   Text="{Binding FullName}">
                <Entry.Triggers>
                    <DataTrigger TargetType="Entry"
                                 Binding="{Binding FullName}"
                                 Value="">
                        <Setter Property="BackgroundColor"
                                Value="{AppThemeBinding Light={StaticResource InputErrorLight}, Dark={StaticResource InputErrorDark}}" />
                    </DataTrigger>
                </Entry.Triggers>
            </Entry>

            <Entry Placeholder="Email Address (Required)"
                   Text="{Binding Email}"
                   Keyboard="Email">
                <Entry.Triggers>
                    <DataTrigger TargetType="Entry"
                                 Binding="{Binding Email}"
                                 Value="">
                        <Setter Property="BackgroundColor"
                                Value="{AppThemeBinding Light={StaticResource InputErrorLight}, Dark={StaticResource InputErrorDark}}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Entry"
                                 Binding="{Binding IsEmailInvalid}"
                                 Value="True">
                        <Setter Property="TextColor"
                                Value="{StaticResource DangerColor}" />
                        <Setter Property="BackgroundColor"
                                Value="{AppThemeBinding Light={StaticResource InputWarningLight}, Dark={StaticResource InputWarningDark}}" />
                    </DataTrigger>
                </Entry.Triggers>
            </Entry>
            <Label Text="* Email must be valid. Students and employees must use @umad.edu.mx or @madero.edu.mx"
                   TextColor="{StaticResource WarningColor}"
                   FontSize="12"
                   IsVisible="False">
                <Label.Triggers>
                    <DataTrigger TargetType="Label"
                                 Binding="{Binding IsEmailInvalid}"
                                 Value="True">
                        <Setter Property="IsVisible"
                                Value="True" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <Entry Placeholder="Student ID (Leave blank if visitor)"
                   Text="{Binding StudentId}"
                   Keyboard="Numeric">
                <Entry.Triggers>
                    <DataTrigger TargetType="Entry"
                                 Binding="{Binding StudentId}"
                                 Value="">
                        <Setter Property="BackgroundColor"
                                Value="#EAECEE" />
                    </DataTrigger>
                    <DataTrigger TargetType="Entry"
                                 Binding="{Binding IsStudentIdInvalid}"
                                 Value="True">
                        <Setter Property="TextColor"
                                Value="{StaticResource DangerColor}" />
                        <Setter Property="BackgroundColor"
                                Value="{AppThemeBinding Light={StaticResource InputWarningLight}, Dark={StaticResource InputWarningDark}}" />
                    </DataTrigger>
                </Entry.Triggers>
            </Entry>
            <Label Text="* Student ID must be exactly 8 digits"
                   TextColor="{StaticResource WarningColor}"
                   FontSize="12"
                   IsVisible="False">
                <Label.Triggers>
                    <DataTrigger TargetType="Label"
                                 Binding="{Binding IsStudentIdInvalid}"
                                 Value="True">
                        <Setter Property="IsVisible"
                                Value="True" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <Entry Placeholder="Password"
                   Text="{Binding Password}"
                   IsPassword="True">
                <Entry.Triggers>
                    <DataTrigger TargetType="Entry"
                                 Binding="{Binding Password}"
                                 Value="">
                        <Setter Property="BackgroundColor"
                                Value="{AppThemeBinding Light={StaticResource InputErrorLight}, Dark={StaticResource InputErrorDark}}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Entry"
                                 Binding="{Binding IsPasswordInvalid}"
                                 Value="True">
                        <Setter Property="TextColor"
                                Value="{StaticResource DangerColor}" />
                        <Setter Property="BackgroundColor"
                                Value="{AppThemeBinding Light={StaticResource InputWarningLight}, Dark={StaticResource InputWarningDark}}" />
                    </DataTrigger>
                </Entry.Triggers>
            </Entry>
            <Label Text="* Password must have at least 8 characters, including uppercase, lowercase, numbers and a special character"
                   TextColor="{StaticResource WarningColor}"
                   FontSize="12"
                   IsVisible="False">
                <Label.Triggers>
                    <DataTrigger TargetType="Label"
                                 Binding="{Binding IsPasswordInvalid}"
                                 Value="True">
                        <Setter Property="IsVisible"
                                Value="True" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <Picker Title="Select your Role"
                    ItemsSource="{Binding Roles}"
                    ItemDisplayBinding="{Binding RoleName}"
                    SelectedItem="{Binding Role}" />

            <Button Text="Create Account &amp; Request Access"
                    Command="{Binding SaveUserCommand}"
                    BackgroundColor="{StaticResource SuccessColor}"
                    TextColor="White"
                    Margin="0,20,0,0">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding IsFormValid}"
                                 Value="False">
                        <Setter Property="IsEnabled"
                                Value="False" />
                        <Setter Property="BackgroundColor"
                                Value="{AppThemeBinding Light={StaticResource DisabledLight}, Dark={StaticResource DisabledDark}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
