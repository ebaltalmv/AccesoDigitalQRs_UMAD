<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Acceso_UMAD_QRs.ViewModels"
             xmlns:models="clr-namespace:SharedResources.Models;assembly=SharedResources"
             x:Class="Acceso_UMAD_QRs.Views.AprobacionesView"
             x:DataType="vm:TokenAccesoViewModel"
             Title="Aprobaciones Pendientes">
    
    <Grid RowDefinitions="Auto, *">
        <Label Grid.Row="0"
               Text="Solicitudes de Acceso"
               FontSize="20"
               FontAttributes="Bold"
               Margin="20,10" />

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding SolicitudesPendientes}"
                        Margin="10">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Usuario">
                    <Border Margin="5"
                            Padding="15"
                            Stroke="LightGray"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8">

                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="{Binding NombreCompleto}"
                                       FontAttributes="Bold"
                                       FontSize="16" />
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="{Binding Rol.NombreRol}"
                                           TextColor="Gray" />
                                    <Label Text="{Binding Matricula}"
                                           TextColor="LightGray" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <Button Grid.Column="1"
                                    Text="Gestionar"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TokenAccesoViewModel}}, Path=IrAGenerarTokenCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="#003366"
                                    TextColor="White">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Binding="{Binding EstaAprobado}"
                                                 Value="True">
                                        <Setter Property="Text"
                                                Value="Ver Token" />
                                        <Setter Property="BackgroundColor"
                                                Value="#28B463" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>