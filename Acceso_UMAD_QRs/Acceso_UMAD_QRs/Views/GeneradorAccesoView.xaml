<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Acceso_UMAD_QRs.ViewModels"
             x:Class="Acceso_UMAD_QRs.Views.GeneradorAccesoView"
             x:DataType="vm:TokenAccesoViewModel"
             Title="Generar Token de Acceso">

    <VerticalStackLayout Spacing="20"
                         Padding="30">
        <Label Text="Configurar Acceso para:"
               FontSize="14"
               TextColor="Gray" />
        <Label Text="{Binding Usuario.NombreCompleto}"
               FontSize="24"
               FontAttributes="Bold" />

        <BoxView HeightRequest="1"
                 Color="LightGray" />

        <Label Text="Tipo de Vigencia:"
               FontAttributes="Bold" />
        <HorizontalStackLayout Spacing="20">
            <RadioButton Content="Permanente (Semestral)"
                         IsChecked="True"
                         Value="Permanente"
                         CheckedChanged="OnTypeChanged" />
            <RadioButton Content="Temporal (Invitado)"
                         Value="Temporal"
                         CheckedChanged="OnTypeChanged" />
        </HorizontalStackLayout>

        <Label Text="Días de duración (1-365):"
               FontAttributes="Bold" />
        <Entry Placeholder="Ej. 1"
               Text="{Binding DiasVigencia}"
               Keyboard="Numeric">
            <Entry.Triggers>
                <DataTrigger TargetType="Entry"
                             Binding="{Binding DiasVigencia}"
                             Value="0">
                    <Setter Property="BackgroundColor"
                            Value="#FADBD8" />
                </DataTrigger>
            </Entry.Triggers>
        </Entry>

        <Button Text="Generar y Activar QR"
                Command="{Binding GenerarTokenCommand}"
                BackgroundColor="#28B463"
                TextColor="White"
                HeightRequest="50"
                Margin="0,20,0,0">
            <Button.Triggers>
                <DataTrigger TargetType="Button"
                             Binding="{Binding DiasVigencia}"
                             Value="0">
                    <Setter Property="IsEnabled"
                            Value="False" />
                    <Setter Property="BackgroundColor"
                            Value="Gray" />
                </DataTrigger>
            </Button.Triggers>
        </Button>

        <Label Text="* Al activar, el usuario recibirá su QR inmediatamente en su aplicación."
               TextColor="Gray"
               FontSize="12"
               HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>