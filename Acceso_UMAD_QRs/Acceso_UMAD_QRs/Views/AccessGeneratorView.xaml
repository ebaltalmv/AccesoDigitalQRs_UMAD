<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Acceso_UMAD_QRs.ViewModels"
             x:Class="Acceso_UMAD_QRs.Views.AccessGeneratorView"
             x:DataType="vm:AccessTokenViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
             Title="Generate Access Token">

    <VerticalStackLayout Spacing="20"
                         Padding="30">
        <Label Text="Configure Access for:"
               FontSize="14"
               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
        <Label Text="{Binding User.FullName}"
               FontSize="24"
               FontAttributes="Bold"
               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />

        <BoxView HeightRequest="1"
                 Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

        <Label Text="Validity Type:"
               FontAttributes="Bold"
               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        <HorizontalStackLayout Spacing="20">
            <RadioButton Content="Permanent (Semester)"
                         IsChecked="True"
                         Value="Permanent"
                         CheckedChanged="OnTypeChanged" />
            <RadioButton Content="Temporary (Guest)"
                         Value="Temporary"
                         CheckedChanged="OnTypeChanged" />
        </HorizontalStackLayout>

        <Label Text="Duration in days (1-365):"
               FontAttributes="Bold"
               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        <Entry Placeholder="e.g. 1"
               Text="{Binding ValidityDays}"
               Keyboard="Numeric">
            <Entry.Triggers>
                <DataTrigger TargetType="Entry"
                             Binding="{Binding ValidityDays}"
                             Value="0">
                    <Setter Property="BackgroundColor"
                            Value="{AppThemeBinding Light={StaticResource InputErrorLight}, Dark={StaticResource InputErrorDark}}" />
                </DataTrigger>
            </Entry.Triggers>
        </Entry>

        <Button Text="Generate &amp; Activate QR"
                Command="{Binding GenerateTokenCommand}"
                BackgroundColor="{StaticResource SuccessColor}"
                TextColor="White"
                HeightRequest="50"
                Margin="0,20,0,0">
            <Button.Triggers>
                <DataTrigger TargetType="Button"
                             Binding="{Binding ValidityDays}"
                             Value="0">
                    <Setter Property="IsEnabled"
                            Value="False" />
                    <Setter Property="BackgroundColor"
                            Value="{AppThemeBinding Light={StaticResource DisabledLight}, Dark={StaticResource DisabledDark}}" />
                </DataTrigger>
            </Button.Triggers>
        </Button>

        <Label Text="* Once activated, the user will receive their QR immediately in the app."
               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
               FontSize="12"
               HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>
