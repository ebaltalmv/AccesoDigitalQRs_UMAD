<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Acceso_UMAD_QRs.ViewModels"
             x:Class="Acceso_UMAD_QRs.Views.ScannerView"
             x:DataType="vm:AccessLogViewModel"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
             Title="Scan QR Code">

    <Grid RowDefinitions="Auto, *, Auto">

        <Label Grid.Row="0"
               Text="Active Access Point"
               HorizontalOptions="Center"
               Margin="10"
               FontAttributes="Bold"
               TextColor="{AppThemeBinding Light={StaticResource PrimaryAccent}, Dark={StaticResource PrimaryAccentDark}}" />

        <Border Grid.Row="1"
                Margin="20"
                Padding="0"
                StrokeShape="RoundRectangle 15">
            <Border.Triggers>
                <DataTrigger TargetType="Border"
                             Binding="{Binding ScanState}"
                             Value="0">
                    <Setter Property="BackgroundColor"
                            Value="{AppThemeBinding Light=LightGray, Dark=#2D3748}" />
                </DataTrigger>
                <DataTrigger TargetType="Border"
                             Binding="{Binding ScanState}"
                             Value="1">
                    <Setter Property="BackgroundColor"
                            Value="{StaticResource SuccessColor}" />
                </DataTrigger>
                <DataTrigger TargetType="Border"
                             Binding="{Binding ScanState}"
                             Value="2">
                    <Setter Property="BackgroundColor"
                            Value="{StaticResource DangerColor}" />
                </DataTrigger>
            </Border.Triggers>

            <Grid RowDefinitions="*, Auto">
                <zxing:CameraBarcodeReaderView Grid.Row="0"
                                               x:Name="barcodeReader"
                                               BarcodesDetected="CameraBarcodeReaderView_BarcodesDetected"
                                               IsDetecting="True"
                                               Margin="10">
                    <zxing:CameraBarcodeReaderView.Triggers>
                        <DataTrigger TargetType="zxing:CameraBarcodeReaderView"
                                     Binding="{Binding ScanState}"
                                     Value="1">
                            <Setter Property="IsVisible"
                                    Value="False" />
                        </DataTrigger>
                        <DataTrigger TargetType="zxing:CameraBarcodeReaderView"
                                     Binding="{Binding ScanState}"
                                     Value="2">
                            <Setter Property="IsVisible"
                                    Value="False" />
                        </DataTrigger>
                    </zxing:CameraBarcodeReaderView.Triggers>
                </zxing:CameraBarcodeReaderView>

                <Label Grid.Row="1"
                       Text="{Binding ResultMessage}"
                       FontSize="18"
                       HorizontalTextAlignment="Center"
                       VerticalOptions="Center"
                       Margin="20"
                       FontAttributes="Bold"
                       TextColor="White">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label"
                                     Binding="{Binding ScanState}"
                                     Value="0">
                            <Setter Property="TextColor"
                                    Value="{AppThemeBinding Light=Black, Dark=White}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Grid>
        </Border>

        <HorizontalStackLayout Grid.Row="2"
                               HorizontalOptions="Center"
                               Spacing="15"
                               Margin="0,0,0,20">
            <Button Text="Simulate Success"
                    Command="{Binding SimulateValidAccessCommand}"
                    BackgroundColor="{StaticResource SuccessColor}"
                    TextColor="White" />
            <Button Text="Simulate Failure"
                    Command="{Binding SimulateInvalidAccessCommand}"
                    BackgroundColor="{StaticResource DangerColor}"
                    TextColor="White" />
        </HorizontalStackLayout>

    </Grid>
</ContentPage>
