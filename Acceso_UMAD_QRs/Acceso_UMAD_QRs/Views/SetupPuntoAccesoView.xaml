<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Acceso_UMAD_QRs.ViewModels"
             x:Class="Acceso_UMAD_QRs.Views.SetupPuntoAccesoView"
             x:DataType="vm:RegistroViewModel"
             Title="Configuración de Acceso">

    <VerticalStackLayout Spacing="20"
                         Padding="30"
                         VerticalOptions="Center">
        <Image Source="guard_icon.png"
               HeightRequest="80"
               HorizontalOptions="Center" />
        <Label Text="Configuración de Turno"
               FontSize="24"
               FontAttributes="Bold"
               HorizontalOptions="Center" />
        <Label Text="Selecciona tu ubicación actual antes de comenzar a escanear códigos."
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               TextColor="Gray" />

        <Picker Title="Selecciona el Punto de Acceso"
                ItemsSource="{Binding PuntosDeAcceso}"
                SelectedItem="{Binding PuntoSeleccionado}"
                Margin="0,15,0,0" />

        <Button Text="Abrir Escáner"
                Command="{Binding IniciarTurnoCommand}"
                BackgroundColor="#003366"
                TextColor="White">
            <Button.Triggers>
                <DataTrigger TargetType="Button"
                             Binding="{Binding PuntoSeleccionado}"
                             Value="{x:Null}">
                    <Setter Property="IsEnabled"
                            Value="False" />
                    <Setter Property="BackgroundColor"
                            Value="Gray" />
                </DataTrigger>
            </Button.Triggers>
        </Button>
    </VerticalStackLayout>
</ContentPage>