<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Acceso_UMAD_QRs.ViewModels"
             x:Class="Acceso_UMAD_QRs.Views.AccessPointSetupView"
             x:DataType="vm:AccessLogViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
             Title="Access Configuration">

    <VerticalStackLayout Spacing="20"
                         Padding="30"
                         VerticalOptions="Center">
        <Image Source="guard_icon.png"
               HeightRequest="80"
               HorizontalOptions="Center" />
        <Label Text="Shift Configuration"
               FontSize="24"
               FontAttributes="Bold"
               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
               HorizontalOptions="Center" />
        <Label Text="Select your current location before scanning codes."
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />

        <Picker Title="Select Access Point"
                ItemsSource="{Binding AccessPoints}"
                SelectedItem="{Binding SelectedPoint}"
                Margin="0,15,0,0" />

        <Button Text="Open Scanner"
                Command="{Binding StartShiftCommand}"
                BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryAccent}, Dark={StaticResource PrimaryAccentDark}}"
                TextColor="White">
            <Button.Triggers>
                <DataTrigger TargetType="Button"
                             Binding="{Binding SelectedPoint}"
                             Value="{x:Null}">
                    <Setter Property="IsEnabled"
                            Value="False" />
                    <Setter Property="BackgroundColor"
                            Value="{AppThemeBinding Light={StaticResource DisabledLight}, Dark={StaticResource DisabledDark}}" />
                </DataTrigger>
            </Button.Triggers>
        </Button>
    </VerticalStackLayout>
</ContentPage>
